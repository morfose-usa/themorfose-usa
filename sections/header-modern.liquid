{%- comment -%}
  Modern Header - Left: Logo, Center: Live Search, Right: Account & Cart
  Mega Menu and Nested Menu Support
{%- endcomment -%}

{% include 'global-variables' %}

{%- comment -%} Get announcement bar blocks {%- endcomment -%}
{%- assign selected_blocks_tape = section.blocks | where: 'type', 'tape' -%}
{%- comment -%} Debug: selected_blocks_tape size = {{ selected_blocks_tape.size }} {%- endcomment -%}

{%- comment -%} Get menu - prioritize section settings menu {%- endcomment -%}
{%- assign main_menu = blank -%}

{%- comment -%} First try section settings menu {%- endcomment -%}
{%- if section.settings.menu != blank -%}
  {%- assign main_menu = linklists[section.settings.menu] -%}
{%- endif -%}

{%- comment -%} If section settings menu doesn't exist, try 'mega' menu {%- endcomment -%}
{%- if main_menu == blank -%}
  {%- assign main_menu = linklists['mega'] -%}
{%- endif -%}

{%- comment -%} If still blank, try 'main-menu' as fallback {%- endcomment -%}
{%- if main_menu == blank -%}
  {%- assign main_menu = linklists['main-menu'] -%}
{%- endif -%}

<style>
  /* Modern Header Styles */
  body {
    padding-top: 85px !important;
  }

  /* Adjust body padding when announcement bar is visible */
  body:has(.header-modern__tape:not(.d-none)) {
    padding-top: 120px !important;
  }

  /* Product page with announcement bar */
  @media (min-width: 992px) {
    body:has(.header-modern__tape:not(.d-none)).template-product {
      padding-top: 185px !important;
    }
    
    body:has(.header-modern__tape:not(.d-none)).template-product .product-page,
    body:has(.header-modern__tape:not(.d-none)).template-product .breadcrumbs {
      margin-top: 55px !important;
      padding-top: 0 !important;
    }
  }


  /* Adjust body padding when announcement bar is visible */
  .header-modern__tape:not(.d-none) ~ * {
    /* This will be handled by JavaScript */
  }

  @media (min-width: 992px) {
    body {
      padding-top: 85px !important;
    }
    
    /* General rule: Ensure all page content is below header */
    main#MainContent {
      margin-top: 0 !important;
      padding-top: 0 !important;
      position: relative;
      z-index: 1;
    }
    
    main#MainContent > section:first-child,
    main#MainContent > div:first-child,
    main#MainContent > *:first-child {
      margin-top: 0 !important;
      padding-top: 0 !important;
      position: relative;
    }
    
    /* Collection page - account for header + menu bar height (85px header + ~65px menu = ~150px) */
    {%- if template.name == 'collection' -%}
    body {
      padding-top: 150px !important;
    }
    {%- endif -%}
    
    /* Product page - account for header + menu bar height */
    {%- if template.name == 'product' -%}
    body {
      padding-top: 150px !important;
    }
    
    /* Product page content - ensure proper spacing - override all margin-top classes */
    .product-page,
    .product-page[class*="mt-"],
    .breadcrumbs,
    main#MainContent > section:first-child,
    main#MainContent > section:first-child > *:first-child,
    .product-page__container,
    .product-page__main,
    single-product,
    .product-page__container--with-sidebar,
    main#MainContent section[class*="main-product"],
    main#MainContent section[class*="product"] {
      margin-top: 0 !important;
      padding-top: 0 !important;
    }
    {%- endif -%}
    
    /* Collection page content - ensure proper spacing */
    {%- if template.name == 'collection' -%}
    .collection-filters,
    .collections,
    #main-collection-filters {
      margin-top: 60px !important;
      padding-top: 0 !important;
      position: relative;
    }
    
    main#MainContent > section:first-child {
      margin-top: 0 !important;
      padding-top: 0 !important;
      position: relative;
    }
    {%- endif -%}
    
    /* Ensure main content starts below header */
    main#MainContent {
      padding-top: 0 !important;
      margin-top: 0 !important;
      position: relative;
      z-index: 1;
    }
    
    /* Ensure first section in main content is not hidden */
    main#MainContent > *:first-child {
      margin-top: 0 !important;
      padding-top: 0 !important;
    }
    
    /* Ensure all sections in main content are below header */
    main#MainContent > section {
      margin-top: 0 !important;
      padding-top: 0 !important;
    }
    
    /* Override any negative margins that might pull content up */
    main#MainContent > section:first-child,
    main#MainContent > div:first-child,
    main#MainContent > *:first-child {
      margin-top: 0 !important;
      padding-top: 0 !important;
      position: relative;
    }
    
    /* Fix slider positioning - ensure it's below header */
    .slider {
      margin-top: 0 !important;
      position: relative !important;
    }
    
    .slider.position-relative {
      margin-top: 0 !important;
    }
    
    /* Ensure slider container doesn't overlap header */
    main#MainContent .slider:first-child,
    main#MainContent > section:first-child .slider,
    main#MainContent > div:first-child .slider {
      margin-top: 0 !important;
    }
    
    /* Fix for home builder sections with sliders */
    section[class*="home-builder"] .slider,
    section[class*="builder"] .slider {
      margin-top: 0 !important;
    }
    
    /* Fix slider rimage positioning - ensure it's below header */
    .rimage.d-none.d-sm-block {
      margin-top: 70px !important;
    }
  }

  @media (max-width: 991px) {
    body {
      padding-top: 75px !important;
    }
  }

  .header-modern {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 10000;
    background: #ffffff;
    border-bottom: 1px solid #f0f0f0;
    transition: top 0.3s ease;
    width: 100%;
    max-width: 100%;
    backdrop-filter: blur(10px);
    pointer-events: auto;
  }

  /* Adjust header position when announcement bar is visible */
  body:has(.header-modern__tape:not(.d-none)) .header-modern {
    top: 28px;
  }


  .header-modern.scrolled {
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    background: rgba(255, 255, 255, 0.98);
  }

  .header-modern__container {
    max-width: 1380px;
    width: 100%;
    margin: 0 auto;
    padding: 0 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 85px;
    gap: 10px;
    pointer-events: auto;
  }
  
  @media (max-width: 1399px) {
    .header-modern__container {
      max-width: 100%;
    }
  }

  /* Logo - Sol */
  .header-modern__logo {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    pointer-events: auto;
    min-width: 200px;
  }

  .header-modern__logo a {
    display: flex;
    align-items: center;
    text-decoration: none;
    color: #000;
    pointer-events: auto;
    cursor: pointer;
  }

  .header-modern__logo img,
  .header-modern__logo svg {
    max-height: 50px;
    max-width: 180px;
    width: auto;
    display: block;
  }

  .header-modern__logo h1 {
    margin: 0;
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -0.5px;
  }

  /* Search - Orta */
  .header-modern__search {
    flex: 1;
    max-width: 100%;
    min-width: 0;
    position: relative;
    margin: 0 auto;
    pointer-events: auto;
  }
  
  @media (min-width: 992px) {
    .header-modern__container {
      margin-top: 10px !important;
    }
    .header-modern__search {
      max-width: 600px;
    }
  }
  
  @media (max-width: 1399px) {
    .header-modern__search {
      max-width: 100%;
    }
  }

  .header-modern__search-form {
    position: relative;
    width: 100%;
    margin-bottom: 0 !important;
    pointer-events: auto;
  }

  .header-modern__search-input {
    width: 100%;
    padding: 16px 60px 16px 48px !important;
    border: 2px solid #f0f0f0;
    border-radius: 50px;
    font-size: 15px;
    background: #fafafa;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    outline: none;
    font-weight: 400;
    text-indent: 0;
    margin-bottom: 0 !important;
    pointer-events: auto;
    cursor: text;
  }

  .header-modern__search-input::placeholder {
    color: #999;
    opacity: 1;
  }

  .header-modern__search-input:focus {
    background: #fff;
    border-color: #F36703;
    box-shadow: 0 0 0 4px rgba(243, 103, 3, 0.12);
    transform: translateY(-1px);
  }

  .header-modern__search-icon {
    position: absolute;
    left: 20px;
    top: 50%;
    transform: translateY(-50%);
    width: 18px;
    height: 18px;
    color: #999;
    pointer-events: none;
    transition: color 0.3s ease;
    z-index: 2;
  }

  .header-modern__search-input:focus ~ .header-modern__search-icon {
    color: #F36703;
  }

  .header-modern__search-button {
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 50px;
    height: 50px;
    border: 2px solid #F36703;
    background: #F36703;
    color: #fff;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 2px 8px rgba(243, 103, 3, 0.3);
    pointer-events: auto;
    z-index: 10;
  }

  .header-modern__search-button:hover {
    background: #d45a02;
    transform: translateY(-50%) scale(1.05);
    box-shadow: 0 4px 12px rgba(243, 103, 3, 0.4);
  }

  .header-modern__search-button svg {
    width: 18px;
    height: 18px;
  }

  /* Mobile Search Button */
  .header-modern__search-mobile-btn {
    display: none !important;
    width: 48px;
    height: 48px;
    border: none;
    background: #fafafa;
    border-radius: 50%;
    cursor: pointer;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    position: relative;
    z-index: 10;
    pointer-events: auto;
  }

  @media (max-width: 991px) {
    .header-modern__search-mobile-btn {
      display: flex !important;
    }

    .header-modern__search {
      display: none !important;
    }

    .header-modern__search-drawer {
      display: flex !important;
    }

    .header-modern__search-drawer-backdrop {
      display: block !important;
    }
  }

  @media (min-width: 992px) {
    .header-modern__search-drawer {
      display: none !important;
    }

    .header-modern__search-drawer-backdrop {
      display: none !important;
    }
  }

  .header-modern__search-mobile-btn:hover {
    background: #F36703;
    color: #fff;
    transform: scale(1.05);
  }

  .header-modern__search-mobile-btn svg {
    width: 22px;
    height: 22px;
  }

  /* Mobile Search Drawer Backdrop */
  .header-modern__search-drawer-backdrop {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: 9998;
    opacity: 0;
    transition: opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    pointer-events: none;
  }

  .header-modern__search-drawer-backdrop.active {
    opacity: 1;
    pointer-events: auto;
  }

  /* Mobile Search Drawer */
  .header-modern__search-drawer {
    display: none;
    position: fixed;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
    background: #fff;
    border-radius: 0;
    box-shadow: none;
    transform: translateY(100%);
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), display 0s 0.3s;
    z-index: 9999;
    max-height: 100vh;
    height: 100vh;
    flex-direction: column;
    visibility: hidden;
    overflow-y: auto;
  }

  .header-modern__search-drawer.active {
    transform: translateY(0);
    visibility: visible;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .header-modern__search-drawer-header {
    padding: 20px;
    border-bottom: 1px solid #f0f0f0;
    display: flex;
    align-items: center;
    gap: 15px;
  }

  .header-modern__search-drawer-close {
    width: 44px;
    height: 44px;
    border: none;
    background: #f5f5f5;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: all 0.2s ease;
    color: #666;
  }

  .header-modern__search-drawer-close:hover {
    background: #F36703;
    color: #fff;
    transform: scale(1.05);
  }

  .header-modern__search-drawer-input {
    flex: 1;
    padding: 14px 20px !important;
    border: 2px solid #f0f0f0;
    border-radius: 50px;
    font-size: 16px;
    background: #fafafa;
    outline: none;
    transition: all 0.3s ease;
    margin-bottom: 0 !important;
  }

  .header-modern__search-drawer-input:focus {
    background: #fff;
    border-color: #F36703;
    box-shadow: 0 0 0 3px rgba(243, 103, 3, 0.1);
  }

  .header-modern__search-drawer-content {
    flex: 1;
    overflow-y: auto;
    padding: 20px;
  }

  .header-modern__search-drawer-collections {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 15px;
    margin-bottom: 20px;
  }

  .header-modern__search-drawer-collection-item {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: #000;
    transition: transform 0.2s ease;
  }

  .header-modern__search-drawer-collection-item:active {
    transform: scale(0.98);
  }

  .header-modern__search-drawer-collection-image {
    width: 100%;
    aspect-ratio: 1;
    border-radius: 12px;
    overflow: hidden;
    background: #f5f5f5;
    margin-bottom: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .header-modern__search-drawer-collection-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .header-modern__search-drawer-collection-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ccc;
    background: #fafafa;
  }

  .header-modern__search-drawer-collection-title {
    font-size: 14px;
    font-weight: 600;
    text-align: center;
    line-height: 1.3;
    color: #000;
  }

  .header-modern__search-drawer-last-searched {
    margin-top: 30px;
    margin-bottom: 20px;
  }

  .header-modern__search-drawer-last-searched-title {
    font-size: 16px;
    font-weight: 700;
    margin: 0 0 15px 0;
    color: #000;
  }

  .header-modern__search-drawer-last-searched-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .header-modern__search-drawer-last-searched-item {
    padding: 12px 0;
    border-bottom: 1px solid #f5f5f5;
  }

  .header-modern__search-drawer-last-searched-item::before {
    display: none !important;
  }

  .header-modern__search-drawer-last-searched-item:last-child {
    border-bottom: none;
  }

  .header-modern__search-drawer-last-searched-link {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: #000;
    transition: opacity 0.2s ease;
  }

  .header-modern__search-drawer-last-searched-link:active {
    opacity: 0.7;
  }

  .header-modern__search-drawer-last-searched-image {
    width: 50px;
    height: 50px;
    object-fit: cover;
    border-radius: 8px;
    flex-shrink: 0;
    background: #f5f5f5;
  }

  .header-modern__search-drawer-last-searched-info {
    flex: 1;
    min-width: 0;
  }

  .header-modern__search-drawer-last-searched-name {
    font-size: 14px;
    font-weight: 500;
    margin: 0;
    color: #000;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .header-modern__search-drawer-results {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .header-modern__search-drawer-result-item {
    padding: 16px 0;
    border-bottom: 1px solid #f5f5f5;
    display: flex;
    align-items: center;
    gap: 15px;
  }

  .header-modern__search-drawer-result-item::before {
    display: none !important;
  }

  .header-modern__search-drawer-result-item:last-child {
    border-bottom: none;
  }

  .header-modern__search-drawer-result-link {
    display: flex;
    align-items: center;
    gap: 15px;
    text-decoration: none;
    color: #000;
    flex: 1;
  }

  .header-modern__search-drawer-result-image {
    width: 60px;
    height: 60px;
    object-fit: cover;
    border-radius: 8px;
    flex-shrink: 0;
  }

  .header-modern__search-drawer-result-info {
    flex: 1;
  }

  .header-modern__search-drawer-result-title {
    font-size: 16px;
    font-weight: 600;
    margin: 0 0 4px 0;
  }

  .header-modern__search-drawer-result-price {
    font-size: 14px;
    color: #666;
  }

  .header-modern__search-drawer-empty {
    text-align: center;
    padding: 40px 20px;
    color: #666;
  }

  .header-modern__search-drawer-loading {
    text-align: center;
    padding: 40px 20px;
    color: #666;
  }

  /* Search Results Dropdown */
  .header-modern__search-results {
    position: absolute;
    top: calc(100% + 15px);
    left: 0;
    right: 0;
    background: #fff;
    border: 1px solid #f0f0f0;
    border-radius: 16px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.12);
    max-height: 550px;
    overflow-y: auto;
    display: none;
    z-index: 1001;
    backdrop-filter: blur(10px);
  }

  .header-modern__search-results.active {
    display: block;
  }

  .header-modern__search-results-loading {
    padding: 20px;
    text-align: center;
    color: #666;
  }

  .header-modern__search-results-empty {
    padding: 30px 20px;
    text-align: center;
    color: #666;
  }

  .header-modern__search-results-list {
    list-style: none;
    margin: 0;
    padding: 10px 0;
  }

  .header-modern__search-result-item {
    padding: 16px 24px;
    border-bottom: 1px solid #f5f5f5;
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
    gap: 15px;
  }

  .header-modern__search-result-item::before {
    display: none !important;
  }

  .header-modern__search-result-item:last-child {
    border-bottom: none;
  }

  .header-modern__search-result-item:hover {
    background: #fafafa;
    transform: translateX(4px);
  }

  .header-modern__search-result-item:hover .header-modern__search-result-title {
    color: #F36703;
  }

  .header-modern__search-result-link {
    display: flex;
    align-items: center;
    gap: 15px;
    text-decoration: none;
    color: #000;
    flex: 1;
  }

  .header-modern__search-result-image {
    width: 50px;
    height: 50px;
    object-fit: cover;
    border-radius: 4px;
    flex-shrink: 0;
  }

  .header-modern__search-result-info {
    flex: 1;
  }

  .header-modern__search-result-title {
    font-size: 15px;
    font-weight: 600;
    margin: 0 0 6px 0;
    transition: color 0.2s ease;
  }

  .header-modern__search-result-price {
    font-size: 13px;
    color: #666;
  }

  .header-modern__search-quick-add {
    flex-shrink: 0;
    margin-left: auto;
  }

  .header-modern__search-quick-add form {
    display: block !important;
  }

  .header-modern__search-quick-add-btn {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid #e0e0e0;
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
    color: #F36703;
    padding: 0;
    margin: 0;
  }

  .header-modern__search-quick-add-btn:hover {
    background: #F36703;
    color: #fff;
    border-color: #F36703;
    transform: scale(1.1);
  }

  .header-modern__search-quick-add-btn:active {
    transform: scale(0.95);
  }

  .header-modern__search-quick-add-btn.loading,
  .header-modern__search-quick-add-btn.active {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .header-modern__search-quick-add-btn[data-button-status="added"] {
    background: #4caf50;
    border-color: #4caf50;
    color: #fff;
  }

  .header-modern__search-quick-add-btn svg {
    width: 18px;
    height: 18px;
  }

  .header-modern__search-view-all {
    padding: 20px 24px;
    text-align: center;
    border-top: 1px solid #f0f0f0;
    background: #fafafa;
  }

  .header-modern__search-view-all a {
    color: #F36703;
    text-decoration: none;
    font-weight: 600;
    font-size: 15px;
    transition: all 0.3s ease;
    display: inline-block;
  }

  .header-modern__search-view-all a:hover {
    color: #d45a02;
    transform: translateX(4px);
  }

  /* Actions - Right */
  .header-modern__actions {
    display: flex;
    align-items: center;
    gap: 0px;
    flex-shrink: 0;
    pointer-events: auto;
  }

  .header-modern__action {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    color: #000;
    text-decoration: none;
    border-radius: 50%;
    overflow: visible;
    z-index: 1;
    pointer-events: auto;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    background: #fafafa;
  }

  .header-modern__action:hover {
    background: #F36703;
    color: #fff;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(243, 103, 3, 0.3);
  }

  .header-modern__action svg {
    width: 22px;
    height: 22px;
    transition: transform 0.3s ease;
  }

  .header-modern__action:hover svg {
    transform: scale(1.1);
  }

