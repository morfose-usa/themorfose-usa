{%- if selected_blocks_tape.size > 0 -%}
  {%- for block in selected_blocks_tape -%}
    <div class="d-none js-header-modern-tape" data-js-show-once="{{ header_tape_show_once }}" data-js-delay="{{ block.settings.delay }}" data-js-cookies-life="{{ header_tape_cookies_life }}">
    <div class="header-modern__tape header-modern__tape--style-{{ block.settings.style }}" style="background: {{ announcement_bg_color }};">
      <div class="header-modern__tape-content">
        <div class="header-modern__tape-text">
          {%- if announcement_text_1 != blank -%}
            <span class="header-modern__tape-text-item">{{ announcement_text_1 }}</span>
          {%- endif -%}
          {%- if announcement_text_2 != blank -%}
            <span class="header-modern__tape-text-item">{{ announcement_text_2 }}</span>
          {%- endif -%}
          {%- if announcement_text_3 != blank -%}
            <span class="header-modern__tape-text-item">{{ announcement_text_3 }}</span>
          {%- endif -%}
          {%- if announcement_text_1 == blank and announcement_text_2 == blank and announcement_text_3 == blank -%}
            {{ block.settings.content }}
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
  {%- if block.settings.delay == 0 -%}
    <script>
      if(document.cookie.indexOf('header-tape=off') === -1) {
        var tapeElement = document.querySelector('.js-header-modern-tape');
        if(tapeElement) {
          tapeElement.classList.remove('d-none');
        }
      }
    </script>
  {%- endif -%}
  {%- endfor -%}
{%- else -%}
  {%- comment -%} No tape blocks found - use section settings {%- endcomment -%}
  {%- if announcement_text_1 != blank or announcement_text_2 != blank or announcement_text_3 != blank -%}
    <div class="d-none js-header-modern-tape" data-js-show-once="true" data-js-delay="0" data-js-cookies-life="1">
      <div class="header-modern__tape header-modern__tape--style-1" style="background: {{ announcement_bg_color }};">
        <div class="header-modern__tape-content">
          <div class="header-modern__tape-text">
            {%- if announcement_text_1 != blank -%}
              <span class="header-modern__tape-text-item">{{ announcement_text_1 }}</span>
            {%- endif -%}
            {%- if announcement_text_2 != blank -%}
              <span class="header-modern__tape-text-item">{{ announcement_text_2 }}</span>
            {%- endif -%}
            {%- if announcement_text_3 != blank -%}
              <span class="header-modern__tape-text-item">{{ announcement_text_3 }}</span>
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
    <script>
      if(document.cookie.indexOf('header-tape=off') === -1) {
        var tapeElement = document.querySelector('.js-header-modern-tape');
        if(tapeElement) {
          tapeElement.classList.remove('d-none');
        }
      }
    </script>
  {%- endif -%}
{%- endif -%}

<header class="header-modern" id="header-modern">
  <div class="header-modern__container">
    <!-- Logo - Sol -->
    <div class="header-modern__logo">
      {%- if template.name == 'index' -%}
        <h1>
      {%- endif -%}
      <a href="{{ routes.root_url }}">
        {%- if settings.logo_types == 'svg' and settings.logo_svg_file != blank -%}
          {%- render settings.logo_svg_file -%}
        {%- elsif settings.logo_types == 'image' and settings.logo_image != blank -%}
          <img src="{{ settings.logo_image | img_url: '200x' }}" alt="{{ shop.name }}" loading="eager">
        {%- else -%}
          <span style="font-size: 20px; font-weight: 600;">{{ shop.name }}</span>
        {%- endif -%}
      </a>
      {%- if template.name == 'index' -%}
        </h1>
      {%- endif -%}
    </div>

    <!-- Search - Orta (Desktop) -->
    {%- if settings.search_show -%}
      <div class="header-modern__search">
        <form class="header-modern__search-form" action="{{ routes.search_url }}" method="get" role="search">
          <input 
            type="search" 
            name="q" 
            class="header-modern__search-input" 
            placeholder="Search products..." 
            autocomplete="off"
            id="header-search-input"
          >
          <svg class="header-modern__search-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
          <button type="submit" class="header-modern__search-button" aria-label="Search">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
          </button>
        </form>
        
        <!-- Search Results Dropdown -->
        <div class="header-modern__search-results" id="search-results">
          <div class="header-modern__search-results-loading" style="display: none;">
            Searching...
          </div>
          <div class="header-modern__search-results-empty" style="display: none;">
            No results found
          </div>
          <ul class="header-modern__search-results-list" id="search-results-list"></ul>
          <div class="header-modern__search-view-all" id="search-view-all" style="display: none;">
            <a href="#" id="search-view-all-link">View all results</a>
          </div>
        </div>
      </div>
    {%- endif -%}

    <!-- Actions - Right -->
    <div class="header-modern__actions">
      <!-- Mobile Search Button -->
      {%- if settings.search_show -%}
        <button class="header-modern__search-mobile-btn" id="mobile-search-btn" aria-label="Search">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </button>
      {%- endif -%}

      <!-- Account - Desktop Only -->
      {%- if settings.account_show_header_button and shop.customer_accounts_enabled -%}
        <a href="{% if customer %}/account{% else %}/account/login{% endif %}" class="header-modern__action header-modern__action--account" aria-label="Account">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
          </svg>
        </a>
      {%- endif -%}

      <!-- Cart -->
      {%- if settings.cart_show_header_button -%}
        <a href="/cart" class="header-modern__action js-popup-button" data-js-popup-button="cart" aria-label="Cart">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path>
          </svg>
          {%- if cart.item_count > 0 -%}
            <span class="header-modern__cart-count">{{ cart.item_count }}</span>
          {%- endif -%}
        </a>
      {%- endif -%}

      <!-- Mobile Menu Button -->
      {%- if main_menu.links.size > 0 -%}
        <button class="header-modern__mobile-menu-btn" id="mobile-menu-btn" aria-label="Menu">
          <span></span>
        </button>
      {%- endif -%}
    </div>
  </div>

  <!-- Desktop Menu -->
  {%- if main_menu.links.size > 0 -%}
    <div class="header-modern__menu">
      <div class="header-modern__menu-container">
        <nav class="header-modern__menu-nav">
          {%- for link in main_menu.links -%}
            {%- comment -%} Check for menu item image {%- endcomment -%}
            {%- assign menu_item_image = blank -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'menu_item_image' and block.settings.menu_item_title == link.title -%}
                {%- assign menu_item_image = block.settings.image -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}
            
            <div class="header-modern__menu-item{% if link.links.size > 0 %} header-modern__menu-item--has-children{% endif %}">
              {%- if menu_item_image != blank -%}
                <div class="header-modern__menu-item-image">
                  <img src="{{ menu_item_image | img_url: '300x200' }}" alt="{{ link.title }}" loading="lazy" width="300" height="200">
                </div>
              {%- endif -%}
              <a href="{{ link.url }}" class="header-modern__menu-link">
                {{ link.title }}
              </a>
              
              {%- if link.links.size > 0 -%}
                {%- comment -%} Always use Mega Menu Layout for better UX {%- endcomment -%}
                {%- comment -%} Get banners for this menu item {%- endcomment -%}
                {%- assign menu_banner_1 = blank -%}
                {%- assign menu_banner_2 = blank -%}
                {%- assign menu_banner_1_position = 'bottom' -%}
                {%- assign menu_banner_2_position = 'bottom' -%}
                {%- assign menu_banner_1_url = blank -%}
                {%- assign menu_banner_2_url = blank -%}
                {%- for block in section.blocks -%}
                  {%- if block.type == 'mega_menu_banner' and block.settings.menu_item_title == link.title -%}
                    {%- if menu_banner_1 == blank -%}
                      {%- assign menu_banner_1 = block.settings.image -%}
                      {%- assign menu_banner_1_position = block.settings.position -%}
                      {%- assign menu_banner_1_url = block.settings.url -%}
                    {%- elsif menu_banner_2 == blank -%}
                      {%- assign menu_banner_2 = block.settings.image -%}
                      {%- assign menu_banner_2_position = block.settings.position -%}
                      {%- assign menu_banner_2_url = block.settings.url -%}
                    {%- endif -%}
                  {%- endif -%}
                {%- endfor -%}
                
                <div class="header-modern__mega-menu">
                  <div class="header-modern__mega-menu-wrapper{% if menu_banner_1 != blank or menu_banner_2 != blank %} header-modern__mega-menu-wrapper--with-banners{% endif %}">
                    {%- if menu_banner_1 != blank and menu_banner_1_position == 'right' -%}
                      <div class="header-modern__mega-menu-banners header-modern__mega-menu-banners--right">
                        {%- if menu_banner_1_url != blank -%}
                          <a href="{{ menu_banner_1_url }}" class="header-modern__mega-menu-banner">
                            <img src="{{ menu_banner_1 | image_url: width: 400 }}" alt="Banner" loading="lazy" width="400" height="600" style="object-fit: cover;">
                          </a>
                        {%- else -%}
                          <div class="header-modern__mega-menu-banner">
                            <img src="{{ menu_banner_1 | image_url: width: 400 }}" alt="Banner" loading="lazy" width="400" height="600" style="object-fit: cover;">
                          </div>
                        {%- endif -%}
                        {%- if menu_banner_2 != blank and menu_banner_2_position == 'right' -%}
                          {%- if menu_banner_2_url != blank -%}
                            <a href="{{ menu_banner_2_url }}" class="header-modern__mega-menu-banner">
                              <img src="{{ menu_banner_2 | image_url: width: 400 }}" alt="Banner" loading="lazy" width="400" height="600" style="object-fit: cover;">
                            </a>
                          {%- else -%}
                            <div class="header-modern__mega-menu-banner">
                              <img src="{{ menu_banner_2 | image_url: width: 400 }}" alt="Banner" loading="lazy" width="400" height="600" style="object-fit: cover;">
                            </div>
                          {%- endif -%}
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                    
                    <div class="header-modern__mega-menu-content">
                    {%- for sub_link in link.links -%}
                      {%- comment -%} Check if this is a collection link and get collection image {%- endcomment -%}
                      {%- assign collection_for_image = blank -%}
                      {%- assign custom_collection_image = blank -%}
                      {%- if section.settings.mega_menu_show_collection_images -%}
                        {%- comment -%} Try to get collection from URL {%- endcomment -%}
                        {%- if sub_link.url contains '/collections/' -%}
                          {%- assign collection_handle = sub_link.url | split: '/collections/' | last | split: '/' | first -%}
                          {%- assign collection_for_image = collections[collection_handle] -%}
                        {%- endif -%}
                        {%- if collection_for_image != blank -%}
                          {%- for block in section.blocks -%}
                            {%- if block.type == 'collection_image' and block.settings.collection != blank -%}
                              {%- assign block_collection = collections[block.settings.collection] -%}
                              {%- if block_collection.handle == collection_for_image.handle -%}
                                {%- assign custom_collection_image = block.settings.image -%}
                                {%- break -%}
                              {%- endif -%}
                            {%- endif -%}
                          {%- endfor -%}
                        {%- endif -%}
                      {%- endif -%}
                      {%- comment -%} Check for mega menu title image {%- endcomment -%}
                      {%- assign mega_menu_title_image = blank -%}
                      {%- for block in section.blocks -%}
                        {%- if block.type == 'mega_menu_title_image' and block.settings.title == sub_link.title -%}
                          {%- assign mega_menu_title_image = block.settings.image -%}
                          {%- break -%}
                        {%- endif -%}
                      {%- endfor -%}
                      
                      <div class="header-modern__mega-menu-column">
                        <div class="header-modern__mega-menu-title">
                          {%- if mega_menu_title_image != blank -%}
                            <div class="header-modern__mega-menu-title-image">
                              <img src="{{ mega_menu_title_image | image_url: width: 160 }}" alt="{{ sub_link.title }}" loading="lazy" width="160" height="160" style="object-fit: cover;">
                            </div>
                          {%- elsif section.settings.mega_menu_show_collection_images -%}
                            {%- if collection_for_image != blank -%}
                              {%- if custom_collection_image != blank or collection_for_image.featured_image != blank -%}
                                <div class="header-modern__mega-menu-title-image">
                                  {%- if custom_collection_image != blank -%}
                                    <img src="{{ custom_collection_image | image_url: width: 160 }}" alt="{{ sub_link.title }}" loading="lazy" width="160" height="160" style="object-fit: cover;">
                                  {%- elsif collection_for_image.featured_image != blank -%}
                                    <img src="{{ collection_for_image.featured_image | image_url: width: 160 }}" alt="{{ sub_link.title }}" loading="lazy" width="160" height="160" style="object-fit: cover;">
                                  {%- endif -%}
                                </div>
                              {%- endif -%}
                            {%- endif -%}
                          {%- endif -%}
                          <a href="{{ sub_link.url }}">{{ sub_link.title }}</a>
                        </div>
                        {%- if sub_link.links.size > 0 -%}
                          <ul class="header-modern__mega-menu-list">
                            {%- for sub_sub_link in sub_link.links -%}
                              <li>
                                <a href="{{ sub_sub_link.url }}" class="header-modern__mega-menu-link">
                                  {{ sub_sub_link.title }}
                                </a>
                              </li>
                            {%- endfor -%}
                          </ul>
                        {%- else -%}
                          {%- comment -%} If no sub-links, show the main link as a single item {%- endcomment -%}
                          <ul class="header-modern__mega-menu-list">
                            <li>
                              <a href="{{ sub_link.url }}" class="header-modern__mega-menu-link">
                                View All
                              </a>
                            </li>
                          </ul>
                        {%- endif -%}
                      </div>
                    {%- endfor -%}
                    </div>
                    
                    {%- if menu_banner_1 != blank and menu_banner_1_position == 'bottom' -%}
                      <div class="header-modern__mega-menu-banners header-modern__mega-menu-banners--bottom">
                        {%- if menu_banner_1_url != blank -%}
                          <a href="{{ menu_banner_1_url }}" class="header-modern__mega-menu-banner">
                            <img src="{{ menu_banner_1 | image_url: width: 1200 }}" alt="Banner" loading="lazy" width="1200" height="300" style="object-fit: cover;">
                          </a>
                        {%- else -%}
                          <div class="header-modern__mega-menu-banner">
                            <img src="{{ menu_banner_1 | image_url: width: 1200 }}" alt="Banner" loading="lazy" width="1200" height="300" style="object-fit: cover;">
                          </div>
                        {%- endif -%}
                        {%- if menu_banner_2 != blank and menu_banner_2_position == 'bottom' -%}
                          {%- if menu_banner_2_url != blank -%}
                            <a href="{{ menu_banner_2_url }}" class="header-modern__mega-menu-banner">
                              <img src="{{ menu_banner_2 | image_url: width: 1200 }}" alt="Banner" loading="lazy" width="1200" height="300" style="object-fit: cover;">
                            </a>
                          {%- else -%}
                            <div class="header-modern__mega-menu-banner">
                              <img src="{{ menu_banner_2 | image_url: width: 1200 }}" alt="Banner" loading="lazy" width="1200" height="300" style="object-fit: cover;">
                            </div>
                          {%- endif -%}
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                  </div>
                </div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </nav>
      </div>
    </div>
  {%- endif -%}

  <!-- Mobile Menu -->
  {%- if main_menu.links.size > 0 -%}
    <div class="header-modern__mobile-menu" id="mobile-menu">
      <div class="header-modern__mobile-menu-header">
        <div class="header-modern__mobile-menu-logo">
          <a href="{{ routes.root_url }}">
            {%- if settings.logo_types == 'svg' and settings.logo_svg_file != blank -%}
              {%- render settings.logo_svg_file -%}
            {%- elsif settings.logo_types == 'image' and settings.logo_image != blank -%}
              <img src="{{ settings.logo_image | img_url: '200x' }}" alt="{{ shop.name }}" loading="eager" width="150" height="auto">
            {%- else -%}
              <span style="font-size: 18px; font-weight: 600;">{{ shop.name }}</span>
            {%- endif -%}
          </a>
        </div>
        <button class="header-modern__mobile-menu-close" id="mobile-menu-close" aria-label="Close">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="24" height="24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
      <nav class="header-modern__mobile-nav">
        {%- for link in main_menu.links -%}
          <div class="header-modern__mobile-nav-item">
            <a href="{{ link.url }}" 
               class="header-modern__mobile-nav-link{% if link.links.size > 0 %} has-children{% endif %}"
               {% if link.links.size > 0 %}data-mobile-submenu-toggle{% endif %}>
              {{ link.title }}
            </a>
            {%- if link.links.size > 0 -%}
              <div class="header-modern__mobile-submenu">
                {%- for sub_link in link.links -%}
                  <div class="header-modern__mobile-submenu-item{% if sub_link.links.size > 0 %} header-modern__mobile-submenu-item--has-children{% endif %}">
                    <a href="{{ sub_link.url }}" 
                       class="header-modern__mobile-submenu-link{% if sub_link.links.size > 0 %} has-children{% endif %}"
                       {% if sub_link.links.size > 0 %}data-mobile-submenu-level2-toggle{% endif %}>
                      {{ sub_link.title }}
                    </a>
                    {%- if sub_link.links.size > 0 -%}
                      <div class="header-modern__mobile-submenu-level2">
                        {%- for sub_sub_link in sub_link.links -%}
                          <a href="{{ sub_sub_link.url }}" class="header-modern__mobile-submenu-level2-link">
                            {{ sub_sub_link.title }}
                          </a>
                        {%- endfor -%}
                      </div>
                    {%- endif -%}
                  </div>
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
        
        <!-- Account Button in Mobile Menu -->
        {%- if settings.account_show_header_button and shop.customer_accounts_enabled -%}
          <div class="header-modern__mobile-nav-item header-modern__mobile-nav-item--account">
            <a href="{% if customer %}/account{% else %}/account/login{% endif %}" class="header-modern__mobile-nav-link header-modern__mobile-nav-link--account">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="20" height="20">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
              </svg>
              <span>{% if customer %}My Account{% else %}Sign In{% endif %}</span>
            </a>
          </div>
        {%- endif -%}
      </nav>
    </div>
  {%- endif -%}

  <!-- Mobile Search Drawer -->
  {%- if settings.search_show -%}
    <div class="header-modern__search-drawer-backdrop" id="mobile-search-backdrop"></div>
    <div class="header-modern__search-drawer" id="mobile-search-drawer">
      <div class="header-modern__search-drawer-header">
        <button class="header-modern__search-drawer-close" id="mobile-search-close" aria-label="Close">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="20" height="20">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
        <input 
          type="search" 
          class="header-modern__search-drawer-input" 
          placeholder="Search products..." 
          autocomplete="off"
          id="mobile-search-input"
        >
      </div>
      <div class="header-modern__search-drawer-content">
        <!-- Featured Collections Grid -->
        {%- assign has_collections = false -%}
        {%- if section.settings.search_collection_1 != blank or section.settings.search_collection_2 != blank -%}
          {%- assign has_collections = true -%}
        {%- endif -%}
        
        {%- if has_collections -%}
          <div class="header-modern__search-drawer-collections" id="mobile-search-collections">
            {%- if section.settings.search_collection_1 != blank -%}
              {%- assign collection_1 = collections[section.settings.search_collection_1] -%}
              {%- if collection_1 != blank -%}
                <a href="{{ collection_1.url }}" class="header-modern__search-drawer-collection-item">
                  <div class="header-modern__search-drawer-collection-image">
                    {%- if section.settings.search_collection_1_image != blank -%}
                      <img src="{{ section.settings.search_collection_1_image | img_url: '200x200' }}" alt="{{ collection_1.title }}" loading="lazy" width="200" height="200">
                    {%- elsif collection_1.featured_image != blank -%}
                      <img src="{{ collection_1.featured_image | img_url: '200x200' }}" alt="{{ collection_1.title }}" loading="lazy" width="200" height="200">
                    {%- else -%}
                      <div class="header-modern__search-drawer-collection-placeholder">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="40" height="40">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                        </svg>
                      </div>
                    {%- endif -%}
                  </div>
                  <div class="header-modern__search-drawer-collection-title">{{ collection_1.title }}</div>
                </a>
              {%- endif -%}
            {%- endif -%}
            
            {%- if section.settings.search_collection_2 != blank -%}
              {%- assign collection_2 = collections[section.settings.search_collection_2] -%}
              {%- if collection_2 != blank -%}
                <a href="{{ collection_2.url }}" class="header-modern__search-drawer-collection-item">
                  <div class="header-modern__search-drawer-collection-image">
                    {%- if section.settings.search_collection_2_image != blank -%}
                      <img src="{{ section.settings.search_collection_2_image | img_url: '200x200' }}" alt="{{ collection_2.title }}" loading="lazy" width="200" height="200">
                    {%- elsif collection_2.featured_image != blank -%}
                      <img src="{{ collection_2.featured_image | img_url: '200x200' }}" alt="{{ collection_2.title }}" loading="lazy" width="200" height="200">
                    {%- else -%}
                      <div class="header-modern__search-drawer-collection-placeholder">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="40" height="40">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                        </svg>
                      </div>
                    {%- endif -%}
                  </div>
                  <div class="header-modern__search-drawer-collection-title">{{ collection_2.title }}</div>
                </a>
              {%- endif -%}
            {%- endif -%}
          </div>
        {%- else -%}
          <div class="header-modern__search-drawer-collections" id="mobile-search-collections" style="display: none;"></div>
        {%- endif -%}
        
        <!-- Last Searched Products -->
        <div class="header-modern__search-drawer-last-searched" id="mobile-search-last-searched" style="display: none;">
          <h3 class="header-modern__search-drawer-last-searched-title">Last Searched</h3>
          <ul class="header-modern__search-drawer-last-searched-list" id="mobile-search-last-searched-list"></ul>
        </div>
        
        <!-- Search Results -->
        <div class="header-modern__search-drawer-loading" id="mobile-search-loading" style="display: none;">
          Searching...
        </div>
        <div class="header-modern__search-drawer-empty" id="mobile-search-empty" style="display: none;">
          No results found
        </div>
        <ul class="header-modern__search-drawer-results" id="mobile-search-results"></ul>
      </div>
    </div>
  {%- endif -%}
</header>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    'use strict';
    
    // Announcement Bar (Tape) Functionality
    const tapeElements = document.querySelectorAll('.js-header-modern-tape');
    tapeElements.forEach(function(tapeElement) {
      const delay = parseInt(tapeElement.getAttribute('data-js-delay') || '0', 10);
      const showOnce = tapeElement.getAttribute('data-js-show-once') === 'true';
      const cookiesLife = parseInt(tapeElement.getAttribute('data-js-cookies-life') || '1', 10);
      
      // Check if already closed via cookie
      if (showOnce && document.cookie.indexOf('header-tape=off') !== -1) {
        return;
      }
      
      // Show with delay
      function showTape() {
        if (showOnce && document.cookie.indexOf('header-tape=off') !== -1) {
          return;
        }
        tapeElement.classList.remove('d-none');
      }
      
      if (delay > 0) {
        setTimeout(showTape, delay * 1000);
      } else {
        showTape();
      }
      
    });
    
    const header = document.getElementById('header-modern');
    if (!header) {
      console.error('Header element not found');
      return;
    }
    
    const searchInput = document.getElementById('header-search-input');
    const searchResults = document.getElementById('search-results');
    const searchResultsList = document.getElementById('search-results-list');
    const searchLoading = searchResults ? searchResults.querySelector('.header-modern__search-results-loading') : null;
    const searchEmpty = searchResults ? searchResults.querySelector('.header-modern__search-results-empty') : null;
    const searchViewAll = document.getElementById('search-view-all');
    const searchViewAllLink = document.getElementById('search-view-all-link');
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    
    // Debug: Check if mobile menu elements exist
    if (!mobileMenuBtn) {
      console.warn('Mobile menu button not found');
    }
    if (!mobileMenu) {
      console.warn('Mobile menu not found');
    }
    
    const mobileSearchBtn = document.getElementById('mobile-search-btn');
    
    // Debug: Check if mobile search elements exist
    if (!mobileSearchBtn) {
      console.warn('Mobile search button not found');
    }
    const mobileSearchDrawer = document.getElementById('mobile-search-drawer');
    const mobileSearchBackdrop = document.getElementById('mobile-search-backdrop');
    const mobileSearchInput = document.getElementById('mobile-search-input');
    const mobileSearchClose = document.getElementById('mobile-search-close');
    const mobileSearchResults = document.getElementById('mobile-search-results');
    const mobileSearchLoading = document.getElementById('mobile-search-loading');
    const mobileSearchEmpty = document.getElementById('mobile-search-empty');
    const mobileSearchCollections = document.getElementById('mobile-search-collections');
    const mobileSearchLastSearched = document.getElementById('mobile-search-last-searched');
    const mobileSearchLastSearchedList = document.getElementById('mobile-search-last-searched-list');
    
    
    let searchTimeout;
    let currentSearchRequest;
    let mobileSearchTimeout;
    let mobileSearchRequest;

    // Sticky header on scroll
    window.addEventListener('scroll', function() {
      if (window.pageYOffset > 50) {
        header.classList.add('scrolled');
      } else {
        header.classList.remove('scrolled');
      }
    });

    // Live Search
    if (searchInput) {
      // Input focus
      searchInput.addEventListener('focus', function() {
        if (this.value.trim() && searchResultsList.children.length > 0) {
          searchResults.classList.add('active');
        }
      });

      // Input typing
      searchInput.addEventListener('input', function() {
        const query = this.value.trim();
        
        clearTimeout(searchTimeout);
        
        if (query.length < 2) {
          searchResults.classList.remove('active');
          return;
        }

        searchTimeout = setTimeout(function() {
          performSearch(query);
        }, 300);
      });

      // Close results when clicking outside
      document.addEventListener('click', function(e) {
        if (!searchInput.closest('.header-modern__search').contains(e.target)) {
          searchResults.classList.remove('active');
        }
      });

      // Escape key to close
      searchInput.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
          searchResults.classList.remove('active');
          this.blur();
        }
      });
    }

    function performSearch(query) {
      // Cancel previous request
      if (currentSearchRequest) {
        currentSearchRequest.abort();
      }

      // Show loading
      searchLoading.style.display = 'block';
      searchEmpty.style.display = 'none';
      searchViewAll.style.display = 'none';
      searchResultsList.innerHTML = '';
      searchResults.classList.add('active');

      // Build search URL
      const searchUrl = '{{ routes.search_url }}/suggest.json?q=' + encodeURIComponent(query) + '&resources[type]=product&resources[limit]=5';

      // Fetch results
      currentSearchRequest = fetch(searchUrl)
        .then(response => response.json())
        .then(data => {
          searchLoading.style.display = 'none';
          
          if (data.resources && data.resources.results && data.resources.results.products) {
            const products = data.resources.results.products;
            
            if (products.length === 0) {
              searchEmpty.style.display = 'block';
            } else {
              // Render products
              products.forEach(function(product) {
                const item = document.createElement('li');
                item.className = 'header-modern__search-result-item';
                
                const link = document.createElement('a');
                link.href = product.url;
                link.className = 'header-modern__search-result-link';
                
                // Image
                if (product.image) {
                  const img = document.createElement('img');
                  img.src = product.image;
                  img.alt = product.title;
                  img.className = 'header-modern__search-result-image';
                  link.appendChild(img);
                }
                
                // Info
                const info = document.createElement('div');
                info.className = 'header-modern__search-result-info';
                
                const title = document.createElement('div');
                title.className = 'header-modern__search-result-title';
                title.textContent = product.title;
                info.appendChild(title);
                
                if (product.price) {
                  const price = document.createElement('div');
                  price.className = 'header-modern__search-result-price';
                  price.textContent = product.price;
                  info.appendChild(price);
                }
                
                link.appendChild(info);
                item.appendChild(link);
                
                // Add item to list FIRST (so search results appear immediately)
                searchResultsList.appendChild(item);
                
                // Quick Add to Cart Button - Using Theme's Format (add async after item is in DOM)
                {%- if section.settings.search_quick_add_to_cart -%}
                // #region agent log
                fetch('http://127.0.0.1:7243/ingest/38daafca-415c-4896-9b1d-c4bf4c3c00ac',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({location:'header-modern.liquid:quick-add-start',message:'Starting quick add button creation',data:{productId:product.id,productUrl:product.url,settingEnabled:true},timestamp:Date.now(),sessionId:'debug-session',runId:'run1',hypothesisId:'A'})}).catch(()=>{});
                // #endregion
                
                // Extract handle from URL if not provided
                let productHandle = product.handle;
                if (!productHandle && product.url) {
                  // Remove query strings and hash from URL first
                  const cleanUrl = product.url.split('?')[0].split('#')[0];
                  const urlMatch = cleanUrl.match(/\/products\/([^\/]+)/);
                  if (urlMatch) {
                    productHandle = urlMatch[1];
                  }
                }
                
                // #region agent log
                fetch('http://127.0.0.1:7243/ingest/38daafca-415c-4896-9b1d-c4bf4c3c00ac',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({location:'header-modern.liquid:handle-extraction',message:'Extracted handle',data:{productHandle:productHandle,originalUrl:product.url},timestamp:Date.now(),sessionId:'debug-session',runId:'run1',hypothesisId:'C'})}).catch(()=>{});
                // #endregion
                
                // #region agent log
                fetch('http://127.0.0.1:7243/ingest/38daafca-415c-4896-9b1d-c4bf4c3c00ac',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({location:'header-modern.liquid:quick-add-check',message:'Checking product identifier',data:{productId:product.id,productHandle:productHandle,hasIdentifier:!!(product.id || productHandle)},timestamp:Date.now(),sessionId:'debug-session',runId:'run1',hypothesisId:'A'})}).catch(()=>{});
                // #endregion
                
                if (product.id || productHandle) {
                  const quickAdd = document.createElement('div');
                  quickAdd.className = 'header-modern__search-quick-add';
                  
                  // Create form (theme expects a form)
                  const form = document.createElement('form');
                  form.style.display = 'block';
                  form.style.position = 'relative';
                  
                  // Create hidden input for variant ID (will be set after fetching product)
                  const variantInput = document.createElement('input');
                  variantInput.type = 'hidden';
                  variantInput.name = 'id';
                  variantInput.id = 'quick-add-variant-' + (product.id || productHandle);
                  variantInput.value = ''; // Will be set after fetch
                  
                  // Create quantity input
                  const quantityInput = document.createElement('input');
                  quantityInput.type = 'hidden';
                  quantityInput.name = 'quantity';
                  quantityInput.value = '1';
                  
                  form.appendChild(variantInput);
                  form.appendChild(quantityInput);
                  
                  // Create button in theme's format
                  const quickAddBtn = document.createElement('button');
                  quickAddBtn.type = 'submit';
                  quickAddBtn.name = 'add';
                  quickAddBtn.className = 'btn btn--status js-product-button-add-to-cart header-modern__search-quick-add-btn';
                  quickAddBtn.setAttribute('data-js-product-button-add-to-cart', '');
                  quickAddBtn.setAttribute('aria-label', 'Add to cart');
                  
                  quickAddBtn.innerHTML = '<svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="18" height="18"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path></svg>';
                  
                  // Fetch product to get variant ID - Shopify needs handle, not ID
                  if (!productHandle) {
                    // #region agent log
                    fetch('http://127.0.0.1:7243/ingest/38daafca-415c-4896-9b1d-c4bf4c3c00ac',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({location:'header-modern.liquid:quick-add-no-handle',message:'No product handle found',data:{productId:product.id,productUrl:product.url},timestamp:Date.now(),sessionId:'debug-session',runId:'run1',hypothesisId:'B'})}).catch(()=>{});
                    // #endregion
                    return; // Skip if no handle
                  }
                  const productUrl = '/products/' + productHandle + '.js';
                  
                  // Fetch product and add button async (item is already in DOM)
                  fetch(productUrl)
                    .then(response => {
                      if (!response.ok) {
                        throw new Error('Product not found');
                      }
                      return response.json();
                    })
                    .then(productData => {
                      // #region agent log
                      fetch('http://127.0.0.1:7243/ingest/38daafca-415c-4896-9b1d-c4bf4c3c00ac',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({location:'header-modern.liquid:fetch-product',message:'Product data fetched',data:{variantsCount:productData.variants?productData.variants.length:0,productHandle:productHandle},timestamp:Date.now(),sessionId:'debug-session',runId:'run1',hypothesisId:'A'})}).catch(()=>{});
                      // #endregion
                      
                      if (productData.variants && productData.variants.length > 0) {
                        const variant = productData.variants.find(v => v.available) || productData.variants[0];
                        if (variant && variant.id) {
                          variantInput.value = variant.id;
                          
                          // #region agent log
                          fetch('http://127.0.0.1:7243/ingest/38daafca-415c-4896-9b1d-c4bf4c3c00ac',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({location:'header-modern.liquid:fetch-product',message:'Variant ID set, adding button',data:{variantId:variant.id,variantAvailable:variant.available},timestamp:Date.now(),sessionId:'debug-session',runId:'run1',hypothesisId:'A'})}).catch(()=>{});
                          // #endregion
                          
                          // Now add button to form (variant is ready)
                          form.appendChild(quickAddBtn);
                          quickAdd.appendChild(form);
                          item.appendChild(quickAdd);
                        } else {
                          // #region agent log
                          fetch('http://127.0.0.1:7243/ingest/38daafca-415c-4896-9b1d-c4bf4c3c00ac',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({location:'header-modern.liquid:fetch-product',message:'No available variant found',data:{variantsCount:productData.variants.length},timestamp:Date.now(),sessionId:'debug-session',runId:'run1',hypothesisId:'A'})}).catch(()=>{});
                          // #endregion
                          console.error('No available variant found');
                        }
                      } else {
                        // #region agent log
                        fetch('http://127.0.0.1:7243/ingest/38daafca-415c-4896-9b1d-c4bf4c3c00ac',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({location:'header-modern.liquid:fetch-product',message:'No variants found',data:{productHandle:productHandle},timestamp:Date.now(),sessionId:'debug-session',runId:'run1',hypothesisId:'A'})}).catch(()=>{});
                        // #endregion
                        console.error('No variants found');
                      }
                    })
                    .catch(err => {
                      // #region agent log
                      fetch('http://127.0.0.1:7243/ingest/38daafca-415c-4896-9b1d-c4bf4c3c00ac',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({location:'header-modern.liquid:fetch-product',message:'Error fetching product',data:{error:err.message,productHandle:productHandle},timestamp:Date.now(),sessionId:'debug-session',runId:'run1',hypothesisId:'A'})}).catch(()=>{});
                      // #endregion
                      console.error('Error fetching product:', err);
                    });
                } else {
                  // #region agent log
                  fetch('http://127.0.0.1:7243/ingest/38daafca-415c-4896-9b1d-c4bf4c3c00ac',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({location:'header-modern.liquid:quick-add-skip',message:'Skipping button - no product identifier',data:{productId:product.id,productHandle:productHandle},timestamp:Date.now(),sessionId:'debug-session',runId:'run1',hypothesisId:'A'})}).catch(()=>{});
                  // #endregion
                }
                {%- endif -%}
              });
              
              // View all link
              searchViewAllLink.href = '{{ routes.search_url }}?q=' + encodeURIComponent(query) + '&type=product';
              searchViewAll.style.display = 'block';
            }
          } else {
            searchEmpty.style.display = 'block';
          }
        })
        .catch(function(error) {
          if (error.name !== 'AbortError') {
            searchLoading.style.display = 'none';
            searchEmpty.style.display = 'block';
          }
        });
    }

    // Mobile Menu Toggle
    const mobileMenuClose = document.getElementById('mobile-menu-close');
    console.log('Mobile Menu Debug:', {
      mobileMenuBtn: !!mobileMenuBtn,
      mobileMenu: !!mobileMenu,
      mobileMenuClose: !!mobileMenuClose
    });
    
    if (mobileMenuBtn && mobileMenu) {
      function openMobileMenu() {
        console.log('Opening mobile menu');
        mobileMenuBtn.classList.add('active');
        mobileMenu.classList.add('active');
        document.body.style.overflow = 'hidden';
        // Force transform with inline style
        mobileMenu.style.setProperty('transform', 'translateX(0)', 'important');
        mobileMenu.style.setProperty('z-index', '10001', 'important');
        mobileMenu.style.setProperty('height', '100vh', 'important');
        mobileMenu.style.setProperty('display', 'block', 'important');
        console.log('Mobile menu opened, display:', getComputedStyle(mobileMenu).display);
      }

      function closeMobileMenu() {
        console.log('Closing mobile menu');
        mobileMenuBtn.classList.remove('active');
        mobileMenu.classList.remove('active');
        mobileMenu.style.removeProperty('transform');
        mobileMenu.style.removeProperty('z-index');
        mobileMenu.style.removeProperty('height');
        document.body.style.overflow = '';
      }

      mobileMenuBtn.addEventListener('click', function(e) {
        console.log('Mobile menu button clicked');
        e.preventDefault();
        e.stopPropagation();
        const isActive = mobileMenu.classList.contains('active');
        console.log('Menu is active:', isActive);
        if (isActive) {
          closeMobileMenu();
        } else {
          openMobileMenu();
        }
      }, false);

      if (mobileMenuClose) {
        mobileMenuClose.addEventListener('click', function(e) {
          e.preventDefault();
          e.stopPropagation();
          closeMobileMenu();
        }, false);
      }

      // Close menu when clicking outside
      document.addEventListener('click', function(e) {
        if (!header.contains(e.target) && mobileMenu.classList.contains('active')) {
          closeMobileMenu();
        }
      });

      // Mobile submenu toggle
      const submenuToggles = mobileMenu.querySelectorAll('[data-mobile-submenu-toggle]');
      submenuToggles.forEach(toggle => {
        toggle.addEventListener('click', function(e) {
          if (window.innerWidth < 992) {
            e.preventDefault();
            const parent = this.closest('.header-modern__mobile-nav-item');
            const submenu = this.nextElementSibling;
            const isActive = submenu.classList.contains('active');
            
            // Close all other submenus at same level
            const siblings = parent.parentElement.querySelectorAll('.header-modern__mobile-submenu');
            siblings.forEach(s => {
              if (s !== submenu) {
                s.classList.remove('active');
                s.previousElementSibling.classList.remove('active');
              }
            });
            
            if (submenu) {
              submenu.classList.toggle('active');
              this.classList.toggle('active');
            }
          }
        });
      });

      // Mobile submenu level 2 toggle
      const submenuLevel2Toggles = mobileMenu.querySelectorAll('[data-mobile-submenu-level2-toggle]');
      submenuLevel2Toggles.forEach(toggle => {
        toggle.addEventListener('click', function(e) {
          if (window.innerWidth < 992) {
            e.preventDefault();
            const parent = this.closest('.header-modern__mobile-submenu-item');
            const submenu = this.nextElementSibling;
            const isActive = submenu.classList.contains('active');
            
            // Close all other level 2 submenus at same level
            const siblings = parent.parentElement.querySelectorAll('.header-modern__mobile-submenu-level2');
            siblings.forEach(s => {
              if (s !== submenu) {
                s.classList.remove('active');
                s.previousElementSibling.closest('.header-modern__mobile-submenu-item').classList.remove('active');
              }
            });
            
            if (submenu) {
              submenu.classList.toggle('active');
              parent.classList.toggle('active');
            }
          }
        });
      });

      // Close menu on link click (mobile - no children)
      const mobileLinks = mobileMenu.querySelectorAll('.header-modern__mobile-nav-link:not(.has-children), .header-modern__mobile-submenu-link:not([data-mobile-submenu-level2-toggle]), .header-modern__mobile-submenu-level2-link');
      mobileLinks.forEach(link => {
        link.addEventListener('click', function() {
          closeMobileMenu();
        });
      });
      
      // Close menu when account link is clicked
      const accountLink = mobileMenu.querySelector('.header-modern__mobile-nav-link[href*="/account"]');
      if (accountLink) {
        accountLink.addEventListener('click', function() {
          closeMobileMenu();
        });
      }
    }

    // Mobile Search Drawer
    console.log('Mobile Search Debug:', {
      mobileSearchBtn: !!mobileSearchBtn,
      mobileSearchDrawer: !!mobileSearchDrawer,
      mobileSearchInput: !!mobileSearchInput,
      mobileSearchBackdrop: !!mobileSearchBackdrop
    });
    
    if (mobileSearchBtn && mobileSearchDrawer && mobileSearchInput) {
      function openDrawer() {
        console.log('Opening search drawer, window width:', window.innerWidth);
        if (window.innerWidth <= 991) {
          if (mobileSearchBackdrop) {
            mobileSearchBackdrop.style.display = 'block';
            setTimeout(function() {
              mobileSearchBackdrop.classList.add('active');
            }, 10);
          }
          mobileSearchDrawer.style.display = 'flex';
          mobileSearchDrawer.style.setProperty('z-index', '10002', 'important');
          setTimeout(function() {
            mobileSearchDrawer.classList.add('active');
          }, 10);
          document.body.style.overflow = 'hidden';
          setTimeout(function() {
            mobileSearchInput.focus();
          }, 300);
          
          // Show/hide collections based on whether they exist
          if (mobileSearchCollections) {
            const hasCollectionItems = mobileSearchCollections.querySelectorAll('.header-modern__search-drawer-collection-item').length > 0;
            if (hasCollectionItems) {
              mobileSearchCollections.style.display = 'grid';
            } else {
              mobileSearchCollections.style.display = 'none';
            }
          }
          
          // Load last searched products when drawer opens
          if (typeof loadLastSearched === 'function') {
            loadLastSearched();
          }
          console.log('Search drawer opened, display:', getComputedStyle(mobileSearchDrawer).display);
        } else {
          console.log('Window too wide for mobile drawer');
        }
      }

      function closeDrawer() {
        console.log('Closing search drawer');
        mobileSearchDrawer.classList.remove('active');
        if (mobileSearchBackdrop) {
          mobileSearchBackdrop.classList.remove('active');
        }
        setTimeout(function() {
          mobileSearchDrawer.style.display = 'none';
          if (mobileSearchBackdrop) {
            mobileSearchBackdrop.style.display = 'none';
          }
        }, 300);
        document.body.style.overflow = '';
        mobileSearchInput.value = '';
        if (mobileSearchResults) {
          mobileSearchResults.innerHTML = '';
        }
        if (mobileSearchLoading) {
          mobileSearchLoading.style.display = 'none';
        }
        if (mobileSearchEmpty) {
          mobileSearchEmpty.style.display = 'none';
        }
        if (mobileSearchCollections) {
          mobileSearchCollections.style.display = 'grid';
        }
        // Don't set display here - let loadLastSearched() handle it based on data
      }

      // Open drawer
      mobileSearchBtn.addEventListener('click', function(e) {
        console.log('Mobile search button clicked');
        e.preventDefault();
        e.stopPropagation();
        openDrawer();
      }, false);

      // Close drawer
      if (mobileSearchClose) {
        mobileSearchClose.addEventListener('click', closeDrawer);
      }

      // Close drawer on backdrop click
      if (mobileSearchBackdrop) {
        mobileSearchBackdrop.addEventListener('click', closeDrawer);
      }

      // Live search on mobile - her harfte
      mobileSearchInput.addEventListener('input', function() {
        const query = this.value.trim();
        
        clearTimeout(mobileSearchTimeout);
        
        if (query.length === 0) {
          mobileSearchResults.innerHTML = '';
          mobileSearchLoading.style.display = 'none';
          mobileSearchEmpty.style.display = 'none';
          if (mobileSearchCollections) {
            mobileSearchCollections.style.display = 'grid';
          }
          // Reload last searched when input is cleared
          loadLastSearched();
          return;
        }

        // Search on every keystroke
        mobileSearchTimeout = setTimeout(function() {
          performMobileSearch(query);
        }, 200);
      });

      // Close drawer on escape
      mobileSearchInput.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
          closeDrawer();
        }
      });
    }

    function performMobileSearch(query) {
      // Cancel previous request
      if (mobileSearchRequest) {
        mobileSearchRequest.abort();
      }

      // Hide collections and last searched, show loading
      if (mobileSearchCollections) {
        mobileSearchCollections.style.display = 'none';
      }
      if (mobileSearchLastSearched) {
        mobileSearchLastSearched.style.display = 'none';
      }
      mobileSearchLoading.style.display = 'block';
      mobileSearchEmpty.style.display = 'none';
      mobileSearchResults.innerHTML = '';

      // Build search URL
      const searchUrl = '{{ routes.search_url }}/suggest.json?q=' + encodeURIComponent(query) + '&resources[type]=product&resources[limit]=10';

      // Fetch results
      mobileSearchRequest = fetch(searchUrl)
        .then(response => response.json())
        .then(data => {
          mobileSearchLoading.style.display = 'none';
          
          if (data.resources && data.resources.results && data.resources.results.products) {
            const products = data.resources.results.products;
            
            if (products.length === 0) {
              mobileSearchEmpty.style.display = 'block';
            } else {
              // Render products
              products.forEach(function(product) {
                const item = document.createElement('li');
                item.className = 'header-modern__search-drawer-result-item';
                
                const link = document.createElement('a');
                link.href = product.url;
                link.className = 'header-modern__search-drawer-result-link';
                
                // Image
                if (product.image) {
                  const img = document.createElement('img');
                  img.src = product.image;
                  img.alt = product.title;
                  img.className = 'header-modern__search-drawer-result-image';
                  link.appendChild(img);
                }
                
                // Info
                const info = document.createElement('div');
                info.className = 'header-modern__search-drawer-result-info';
                
                const title = document.createElement('div');
                title.className = 'header-modern__search-drawer-result-title';
                title.textContent = product.title;
                info.appendChild(title);
                
                if (product.price) {
                  const price = document.createElement('div');
                  price.className = 'header-modern__search-drawer-result-price';
                  price.textContent = product.price;
                  info.appendChild(price);
                }
                
                link.appendChild(info);
                item.appendChild(link);
                
                // Add item to list FIRST (so search results appear immediately)
                mobileSearchResults.appendChild(item);
                
                // Quick Add to Cart Button - Using Theme's Format (add async after item is in DOM)
                {%- if section.settings.search_quick_add_to_cart -%}
                // Extract handle from URL if not provided
                let productHandle = product.handle;
                if (!productHandle && product.url) {
                  const urlMatch = product.url.match(/\/products\/([^\/\?]+)/);
                  if (urlMatch) {
                    productHandle = urlMatch[1];
                  }
                }
                
                if (product.id || productHandle) {
                  const quickAdd = document.createElement('div');
                  quickAdd.className = 'header-modern__search-quick-add';
                  
                  // Create form (theme expects a form)
                  const form = document.createElement('form');
                  form.style.display = 'block';
                  form.style.position = 'relative';
                  
                  // Create hidden input for variant ID (will be set after fetching product)
                  const variantInput = document.createElement('input');
                  variantInput.type = 'hidden';
                  variantInput.name = 'id';
                  variantInput.id = 'quick-add-variant-mobile-' + (product.id || productHandle);
                  variantInput.value = ''; // Will be set after fetch
                  
                  // Create quantity input
                  const quantityInput = document.createElement('input');
                  quantityInput.type = 'hidden';
                  quantityInput.name = 'quantity';
                  quantityInput.value = '1';
                  
                  form.appendChild(variantInput);
                  form.appendChild(quantityInput);
                  
                  // Create button in theme's format
                  const quickAddBtn = document.createElement('button');
                  quickAddBtn.type = 'submit';
                  quickAddBtn.name = 'add';
                  quickAddBtn.className = 'btn btn--status js-product-button-add-to-cart header-modern__search-quick-add-btn';
                  quickAddBtn.setAttribute('data-js-product-button-add-to-cart', '');
                  quickAddBtn.setAttribute('aria-label', 'Add to cart');
                  
                  quickAddBtn.innerHTML = '<svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="18" height="18"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path></svg>';
                  
                  // Fetch product to get variant ID - Shopify needs handle, not ID
                  if (!productHandle) {
                    // #region agent log
                    fetch('http://127.0.0.1:7243/ingest/38daafca-415c-4896-9b1d-c4bf4c3c00ac',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({location:'header-modern.liquid:quick-add-no-handle-mobile',message:'No product handle found (mobile)',data:{productId:product.id,productUrl:product.url},timestamp:Date.now(),sessionId:'debug-session',runId:'run1',hypothesisId:'B'})}).catch(()=>{});
                    // #endregion
                    return; // Skip if no handle
                  }
                  const productUrl = '/products/' + productHandle + '.js';
                  
                  // Fetch product and add button async (item is already in DOM)
                  fetch(productUrl)
                    .then(response => {
                      if (!response.ok) {
                        throw new Error('Product not found');
                      }
                      return response.json();
                    })
                    .then(productData => {
                      // #region agent log
                      fetch('http://127.0.0.1:7243/ingest/38daafca-415c-4896-9b1d-c4bf4c3c00ac',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({location:'header-modern.liquid:fetch-product-mobile',message:'Product data fetched',data:{variantsCount:productData.variants?productData.variants.length:0,productHandle:productHandle},timestamp:Date.now(),sessionId:'debug-session',runId:'run1',hypothesisId:'A'})}).catch(()=>{});
                      // #endregion
                      
                      if (productData.variants && productData.variants.length > 0) {
                        const variant = productData.variants.find(v => v.available) || productData.variants[0];
                        if (variant && variant.id) {
                          variantInput.value = variant.id;
                          
                          // #region agent log
                          fetch('http://127.0.0.1:7243/ingest/38daafca-415c-4896-9b1d-c4bf4c3c00ac',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({location:'header-modern.liquid:fetch-product-mobile',message:'Variant ID set, adding button',data:{variantId:variant.id,variantAvailable:variant.available},timestamp:Date.now(),sessionId:'debug-session',runId:'run1',hypothesisId:'A'})}).catch(()=>{});
                          // #endregion
                          
                          // Now add button to form (variant is ready)
                          form.appendChild(quickAddBtn);
                          quickAdd.appendChild(form);
                          item.appendChild(quickAdd);
                          
                          // #region agent log
                          fetch('http://127.0.0.1:7243/ingest/38daafca-415c-4896-9b1d-c4bf4c3c00ac',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({location:'header-modern.liquid:quick-add-success-mobile',message:'Button added to DOM (mobile)',data:{variantId:variant.id,itemInDOM:item.parentNode !== null},timestamp:Date.now(),sessionId:'debug-session',runId:'run1',hypothesisId:'A'})}).catch(()=>{});
                          // #endregion
                        } else {
                          // #region agent log
                          fetch('http://127.0.0.1:7243/ingest/38daafca-415c-4896-9b1d-c4bf4c3c00ac',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({location:'header-modern.liquid:fetch-product-mobile',message:'No available variant found',data:{variantsCount:productData.variants.length},timestamp:Date.now(),sessionId:'debug-session',runId:'run1',hypothesisId:'A'})}).catch(()=>{});
                          // #endregion
                          console.error('No available variant found');
                        }
                      } else {
                        // #region agent log
                        fetch('http://127.0.0.1:7243/ingest/38daafca-415c-4896-9b1d-c4bf4c3c00ac',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({location:'header-modern.liquid:fetch-product-mobile',message:'No variants found',data:{productHandle:productHandle},timestamp:Date.now(),sessionId:'debug-session',runId:'run1',hypothesisId:'A'})}).catch(()=>{});
                        // #endregion
                        console.error('No variants found');
                      }
                    })
                    .catch(err => {
                      // #region agent log
                      fetch('http://127.0.0.1:7243/ingest/38daafca-415c-4896-9b1d-c4bf4c3c00ac',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({location:'header-modern.liquid:fetch-product-mobile',message:'Error fetching product',data:{error:err.message,productHandle:productHandle},timestamp:Date.now(),sessionId:'debug-session',runId:'run1',hypothesisId:'A'})}).catch(()=>{});
                      // #endregion
                      console.error('Error fetching product:', err);
                    });
                } else {
                  // #region agent log
                  fetch('http://127.0.0.1:7243/ingest/38daafca-415c-4896-9b1d-c4bf4c3c00ac',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({location:'header-modern.liquid:quick-add-skip-mobile',message:'Skipping button - no product identifier',data:{productId:product.id,productHandle:productHandle},timestamp:Date.now(),sessionId:'debug-session',runId:'run1',hypothesisId:'A'})}).catch(()=>{});
                  // #endregion
                }
                {%- endif -%}
                
                // Add click handler to save to last searched
                link.addEventListener('click', function(e) {
                  saveToLastSearched({
                    title: product.title,
                    url: product.url,
                    image: product.image,
                    price: product.price
                  });
                });
              });
            }
          } else {
            mobileSearchEmpty.style.display = 'block';
          }
        })
        .catch(function(error) {
          if (error.name !== 'AbortError') {
            mobileSearchLoading.style.display = 'none';
            mobileSearchEmpty.style.display = 'block';
          }
        });
    }

    // Last Searched Functions
    function saveToLastSearched(product) {
      try {
        let lastSearched = JSON.parse(localStorage.getItem('header_last_searched') || '[]');
        
        // Remove if already exists
        lastSearched = lastSearched.filter(function(item) {
          return item.url !== product.url;
        });
        
        // Add to beginning
        lastSearched.unshift(product);
        
        // Keep only last 3
        if (lastSearched.length > 3) {
          lastSearched = lastSearched.slice(0, 3);
        }
        
        localStorage.setItem('header_last_searched', JSON.stringify(lastSearched));
        loadLastSearched();
      } catch (e) {
        console.error('Error saving to last searched:', e);
      }
    }

    
    // Update Cart Count
    function updateCartCount() {
      fetch('/cart.js')
        .then(response => response.json())
        .then(cart => {
          const cartCount = document.querySelector('.header-modern__cart-count');
          if (cartCount) {
            const totalItems = cart.item_count || 0;
            cartCount.textContent = totalItems;
            cartCount.style.display = totalItems > 0 ? 'flex' : 'none';
          }
        })
        .catch(function(error) {
          console.error('Error updating cart count:', error);
        });
    }
    
    // Listen to theme's cart added event to update cart count
    document.addEventListener('theme:cart::added', function() {
      updateCartCount();
    });
    
    // Initialize cart count on page load
    updateCartCount();

    function loadLastSearched() {
      if (!mobileSearchLastSearched || !mobileSearchLastSearchedList) {
        return;
      }
      
      try {
        const lastSearched = JSON.parse(localStorage.getItem('header_last_searched') || '[]');
        
        if (lastSearched.length === 0) {
          mobileSearchLastSearched.style.display = 'none';
          return;
        }
        
        mobileSearchLastSearchedList.innerHTML = '';
        
        lastSearched.forEach(function(product) {
          const item = document.createElement('li');
          item.className = 'header-modern__search-drawer-last-searched-item';
          
          const link = document.createElement('a');
          link.href = product.url;
          link.className = 'header-modern__search-drawer-last-searched-link';
          
          // Image
          if (product.image) {
            const img = document.createElement('img');
            img.src = product.image;
            img.alt = product.title;
            img.className = 'header-modern__search-drawer-last-searched-image';
            link.appendChild(img);
          } else {
            const placeholder = document.createElement('div');
            placeholder.className = 'header-modern__search-drawer-last-searched-image';
            placeholder.style.display = 'flex';
            placeholder.style.alignItems = 'center';
            placeholder.style.justifyContent = 'center';
            placeholder.style.background = '#f5f5f5';
            link.appendChild(placeholder);
          }
          
          // Name
          const name = document.createElement('div');
          name.className = 'header-modern__search-drawer-last-searched-name';
          name.textContent = product.title;
          
          const info = document.createElement('div');
          info.className = 'header-modern__search-drawer-last-searched-info';
          info.appendChild(name);
          
          link.appendChild(info);
          item.appendChild(link);
          mobileSearchLastSearchedList.appendChild(item);
        });
        
        mobileSearchLastSearched.style.display = 'block';
      } catch (e) {
        console.error('Error loading last searched:', e);
        mobileSearchLastSearched.style.display = 'none';
      }
    }
  });
</script>

