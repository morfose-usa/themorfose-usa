{% comment %}
  MORFOSE Product Page v2
  Desktop: 3-Column Layout (Title Left | Gallery Center | Info Right)
  Mobile: Optimized touch-friendly layout
  
  Uses separate snippets for each platform for better maintainability
{% endcomment %}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
-%}

<!-- Desktop Layout -->
{%- render 'product-desktop', product: product, current_variant: current_variant, section: section, collection: collection -%}

<!-- Mobile Layout -->
{%- render 'product-mobile', product: product, current_variant: current_variant, section: section, collection: collection -%}

<!-- Shared JavaScript for Desktop -->
<script>
(function() {
  // Only run on desktop
  if (window.innerWidth <= 991) return;
  
  // ========================================
  // DESKTOP GALLERY
  // ========================================
  
  let currentIndex = 0;
  let thumbnails = [];
  let mainImage = null;
  
  function initGallery() {
    mainImage = document.getElementById('morfose-main-image');
    thumbnails = Array.from(document.querySelectorAll('.morfose-desktop__thumbnail'));
    
    if (!mainImage) return;
    
    thumbnails.forEach(function(thumb, index) {
      if (thumb.classList.contains('active')) {
        currentIndex = index;
      }
      thumb.addEventListener('click', function(e) {
        e.preventDefault();
        changeImage(index);
      });
    });
  }
  
  function changeImage(index) {
    if (!mainImage || thumbnails.length === 0) return;
    if (index < 0 || index >= thumbnails.length) return;
    
    currentIndex = index;
    const thumb = thumbnails[index];
    const fullSrc = thumb.getAttribute('data-full-src');
    
    if (fullSrc) {
      mainImage.src = fullSrc;
      mainImage.alt = thumb.alt || '';
    }
    
    thumbnails.forEach(function(t) {
      t.classList.remove('active');
    });
    thumb.classList.add('active');
  }
  
  window.morfoseGalleryPrev = function() {
    if (thumbnails.length === 0) return;
    const newIndex = (currentIndex - 1 + thumbnails.length) % thumbnails.length;
    changeImage(newIndex);
  };
  
  window.morfoseGalleryNext = function() {
    if (thumbnails.length === 0) return;
    const newIndex = (currentIndex + 1) % thumbnails.length;
    changeImage(newIndex);
  };
  
  // ========================================
  // QUANTITY
  // ========================================
  
  window.morfoseUpdateQty = function(change) {
    const input = document.getElementById('morfose-qty');
    if (!input) return;
    let value = parseInt(input.value) || 1;
    value += change;
    if (value < 1) value = 1;
    input.value = value;
  };
  
  // ========================================
  // VARIANT SELECTION
  // ========================================
  
  window.morfoseSelectOption = function(btn) {
    const optionValues = btn.parentElement;
    const buttons = optionValues.querySelectorAll('.morfose-desktop__option-btn, .morfose-desktop__color-swatch');
    buttons.forEach(function(b) {
      b.classList.remove('selected');
    });
    btn.classList.add('selected');
    
    const selectedOptions = [];
    document.querySelectorAll('.morfose-desktop__option').forEach(function(optionGroup) {
      const selected = optionGroup.querySelector('.morfose-desktop__option-btn.selected, .morfose-desktop__color-swatch.selected');
      if (selected) {
        selectedOptions.push(selected.getAttribute('data-value'));
      }
    });
    
    const variantSelect = document.getElementById('morfose-variant-select');
    if (!variantSelect) return;
    
    let matchedOption = null;
    Array.from(variantSelect.options).forEach(function(option) {
      const variantTitle = option.textContent.trim();
      const allMatch = selectedOptions.every(function(opt) {
        return variantTitle.indexOf(opt) !== -1;
      });
      if (allMatch) {
        matchedOption = option;
      }
    });
    
    if (matchedOption) {
      variantSelect.value = matchedOption.value;
      
      const variantName = document.getElementById('morfose-variant-name');
      if (variantName) {
        variantName.textContent = matchedOption.textContent.trim();
      }
      
      const priceEl = document.getElementById('morfose-price');
      const comparePriceEl = document.getElementById('morfose-compare-price');
      const price = matchedOption.getAttribute('data-price');
      const comparePrice = matchedOption.getAttribute('data-compare-price');
      
      if (priceEl && price) {
        priceEl.textContent = price;
      }
      if (comparePriceEl) {
        if (comparePrice && comparePrice !== price) {
          comparePriceEl.textContent = comparePrice;
          comparePriceEl.style.display = '';
        } else {
          comparePriceEl.style.display = 'none';
        }
      }
      
      const addBtn = document.querySelector('.morfose-desktop__add-btn');
      const isAvailable = matchedOption.getAttribute('data-available') === 'true';
      if (addBtn) {
        addBtn.disabled = !isAvailable;
        addBtn.textContent = isAvailable ? 'Add to Bag' : 'Sold Out';
      }
      
      const variantImage = matchedOption.getAttribute('data-image');
      if (variantImage && mainImage) {
        mainImage.src = variantImage;
        thumbnails.forEach(function(thumb, index) {
          const thumbSrc = thumb.getAttribute('data-full-src');
          if (thumbSrc === variantImage) {
            changeImage(index);
          }
        });
      }
      
      if (window.history && window.history.replaceState) {
        const url = new URL(window.location.href);
        url.searchParams.set('variant', matchedOption.value);
        window.history.replaceState({}, '', url.toString());
      }
    }
  };
  
  // ========================================
  // ACCORDION
  // ========================================
  
  window.morfoseToggleAccordion = function(header) {
    const item = header.parentElement;
    const content = item.querySelector('.morfose-desktop__accordion-content');
    const inner = content.querySelector('.morfose-desktop__accordion-inner');
    
    if (!content || !inner) return;
    
    const isOpen = item.classList.contains('open');
    
    if (isOpen) {
      item.classList.remove('open');
      content.style.maxHeight = '0';
    } else {
      document.querySelectorAll('.morfose-desktop__accordion-item.open').forEach(function(openItem) {
        openItem.classList.remove('open');
        const openContent = openItem.querySelector('.morfose-desktop__accordion-content');
        if (openContent) openContent.style.maxHeight = '0';
      });
      
      item.classList.add('open');
      content.style.maxHeight = inner.scrollHeight + 'px';
    }
  };
  
  // Init
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGallery);
  } else {
    initGallery();
  }
  
})();
</script>

{% comment %} Legacy styles kept for backward compatibility - will be removed {% endcomment %}
<style>
  /* ========================================
     MORFOSE PRODUCT PAGE v2 - 3 COLUMN LAYOUT
     ======================================== */
  
  .morfose-product {
    max-width: 1600px;
    margin: 0 auto;
    padding: 20px 30px 60px;
  }

  /* Breadcrumb */
  .morfose-product__breadcrumb {
    font-size: 12px;
    color: #666;
    margin-bottom: 15px;
  }

  .morfose-product__breadcrumb a {
    color: #666;
    text-decoration: none;
  }

  .morfose-product__breadcrumb a:hover {
    text-decoration: underline;
  }

  .morfose-product__breadcrumb span {
    margin: 0 8px;
  }

  /* 3-Column Grid */
  .morfose-product__grid {
    display: grid;
    grid-template-columns: 280px 1fr 380px;
    gap: 40px;
    align-items: start;
    min-height: 600px;
  }

  @media (max-width: 1200px) {
    .morfose-product__grid {
      grid-template-columns: 240px 1fr 320px;
      gap: 30px;
    }
  }

  @media (max-width: 991px) {
    .morfose-product__grid {
      grid-template-columns: 1fr;
      gap: 30px;
    }
  }

  /* ========================================
     LEFT COLUMN - Title & USP
     ======================================== */
  
  .morfose-product__left {
    display: flex;
    flex-direction: column;
    gap: 20px;
    position: sticky;
    top: 120px;
  }

  @media (max-width: 991px) {
    .morfose-product__left {
      position: relative;
      top: 0;
      order: 1;
    }
  }

  .morfose-product__badge {
    display: inline-block;
    background: #f5e6d3;
    color: #8b6914;
    font-size: 10px;
    font-weight: 600;
    padding: 6px 12px;
    border-radius: 3px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    width: fit-content;
  }

  .morfose-product__title {
    font-size: 36px;
    font-weight: 400;
    line-height: 1.15;
    margin: 0;
    color: #000;
    font-family: inherit;
  }

  @media (max-width: 1200px) {
    .morfose-product__title {
      font-size: 28px;
    }
  }

  @media (max-width: 767px) {
    .morfose-product__title {
      font-size: 24px;
    }
  }

  .morfose-product__subtitle {
    font-size: 14px;
    line-height: 1.6;
    color: #666;
    margin: 0;
  }

  .morfose-product__cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: transparent;
    border: 1px solid #000;
    color: #000;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    padding: 14px 24px;
    cursor: pointer;
    transition: all 0.3s;
    width: fit-content;
  }

  .morfose-product__cta-btn:hover {
    background: #000;
    color: #fff;
  }

  .morfose-product__cta-btn svg {
    width: 16px;
    height: 16px;
    transition: transform 0.3s;
  }

  .morfose-product__cta-btn:hover svg {
    transform: translateX(4px);
  }

  /* USP Icons - Left Column */
  .morfose-product__usp-left {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
    margin-top: 20px;
  }

  .morfose-product__usp-item-left {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .morfose-product__usp-icon-left {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f8f8f8;
    flex-shrink: 0;
  }

  .morfose-product__usp-icon-left svg {
    width: 18px;
    height: 18px;
    stroke: #333;
    stroke-width: 1.5;
    fill: none;
  }

  /* ========================================
     CENTER COLUMN - Gallery
     ======================================== */
  
  .morfose-product__gallery {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  @media (max-width: 991px) {
    .morfose-product__gallery {
      order: 2;
    }
  }

  .morfose-product__gallery-main {
    position: relative;
    width: 100%;
    max-width: 550px;
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .morfose-product__main-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: transparent;
  }

  /* Gallery Navigation Arrows */
  .morfose-product__gallery-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 50px;
    height: 50px;
    background: #fff;
    border: 1px solid #e5e5e5;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s;
    z-index: 10;
  }

  .morfose-product__gallery-nav:hover {
    background: #000;
    border-color: #000;
  }

  .morfose-product__gallery-nav:hover svg {
    stroke: #fff;
  }

  .morfose-product__gallery-nav svg {
    width: 20px;
    height: 20px;
    stroke: #000;
    stroke-width: 2;
    fill: none;
  }

  .morfose-product__gallery-prev {
    left: -25px;
  }

  .morfose-product__gallery-next {
    right: -25px;
  }

  @media (max-width: 991px) {
    .morfose-product__gallery-prev {
      left: 10px;
    }
    .morfose-product__gallery-next {
      right: 10px;
    }
  }

  /* Thumbnails */
  .morfose-product__thumbnails {
    display: flex;
    gap: 10px;
    margin-top: 20px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .morfose-product__thumbnail {
    width: 60px;
    height: 60px;
    object-fit: cover;
    border-radius: 4px;
    cursor: pointer;
    border: 2px solid transparent;
    transition: border-color 0.2s;
    opacity: 0.6;
  }

  .morfose-product__thumbnail:hover,
  .morfose-product__thumbnail.active {
    border-color: #000;
    opacity: 1;
  }

  /* ========================================
     RIGHT COLUMN - Product Info
     ======================================== */
  
  .morfose-product__right {
    display: flex;
    flex-direction: column;
    gap: 20px;
    position: sticky;
    top: 120px;
  }

  @media (max-width: 991px) {
    .morfose-product__right {
      position: relative;
      top: 0;
      order: 3;
    }
  }

  /* Variant Name */
  .morfose-product__variant-name {
    font-size: 14px;
    font-weight: 500;
    color: #000;
    margin: 0;
  }

  /* Variant Swatches */
  .morfose-product__variants {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .morfose-product__option {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .morfose-product__option-label {
    font-size: 12px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: #666;
  }

  .morfose-product__option-values {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  /* Color Swatches */
  .morfose-product__color-swatch {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    cursor: pointer;
    border: 2px solid transparent;
    transition: all 0.2s;
    position: relative;
  }

  .morfose-product__color-swatch:hover,
  .morfose-product__color-swatch.selected {
    border-color: #000;
  }

  .morfose-product__color-swatch.selected::after {
    content: '';
    position: absolute;
    top: -5px;
    left: -5px;
    right: -5px;
    bottom: -5px;
    border: 1px solid #000;
    border-radius: 50%;
  }

  /* Size/Text Options */
  .morfose-product__option-btn {
    padding: 12px 20px;
    border: 1px solid #ddd;
    background: #fff;
    font-size: 13px;
    cursor: pointer;
    transition: all 0.2s;
    border-radius: 0;
  }

  .morfose-product__option-btn:hover {
    border-color: #000;
  }

  .morfose-product__option-btn.selected {
    background: #000;
    color: #fff;
    border-color: #000;
  }

  /* Price */
  .morfose-product__price-wrapper {
    display: flex;
    align-items: baseline;
    gap: 15px;
    margin-top: 10px;
  }

  .morfose-product__price {
    font-size: 32px;
    font-weight: 600;
    color: #000;
  }

  .morfose-product__compare-price {
    font-size: 20px;
    color: #999;
    text-decoration: line-through;
  }

  /* Add to Cart - Full Width Bottom */
  .morfose-product__actions-wrapper {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 15px;
  }

  .morfose-product__actions {
    display: flex;
    gap: 12px;
    align-items: stretch;
  }

  .morfose-product__add-btn {
    flex: 1;
    height: 58px;
    background: #000;
    color: #fff;
    border: none;
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    cursor: pointer;
    transition: background 0.2s;
  }

  .morfose-product__add-btn:hover {
    background: #333;
  }

  .morfose-product__add-btn:disabled {
    background: #ccc;
    cursor: not-allowed;
  }

  .morfose-product__wishlist-btn {
    width: 58px;
    height: 58px;
    background: #fff;
    border: 1px solid #ddd;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s;
    flex-shrink: 0;
  }

  .morfose-product__wishlist-btn:hover {
    border-color: #000;
  }

  .morfose-product__wishlist-btn:hover svg {
    fill: #e53935;
    stroke: #e53935;
  }

  .morfose-product__wishlist-btn svg {
    width: 24px;
    height: 24px;
    stroke: #000;
    stroke-width: 1.5;
    fill: none;
    transition: all 0.2s;
  }

  /* Quantity - Inline with Price */
  .morfose-product__quantity-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .morfose-product__quantity {
    display: flex;
    align-items: center;
    border: 1px solid #ddd;
    flex-shrink: 0;
  }

  .morfose-product__qty-btn {
    width: 44px;
    height: 48px;
    border: none;
    background: transparent;
    font-size: 20px;
    cursor: pointer;
    transition: background 0.2s;
  }

  .morfose-product__qty-btn:hover {
    background: #f5f5f5;
  }

  .morfose-product__qty-input {
    width: 50px;
    height: 48px;
    border: none;
    text-align: center;
    font-size: 16px;
    -moz-appearance: textfield;
  }

  .morfose-product__qty-input::-webkit-outer-spin-button,
  .morfose-product__qty-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  /* ========================================
     ACCORDION TABS - Right Column
     ======================================== */
  
  .morfose-product__accordion {
    margin-top: 10px;
  }

  .morfose-accordion__item {
    border-bottom: 1px solid #e5e5e5;
  }

  .morfose-accordion__item:first-child {
    border-top: 1px solid #e5e5e5;
  }

  .morfose-accordion__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 0;
    cursor: pointer;
    user-select: none;
    transition: opacity 0.2s;
  }

  .morfose-accordion__header:hover {
    opacity: 0.7;
  }

  .morfose-accordion__title {
    font-size: 12px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 1.2px;
    margin: 0;
    color: #000;
  }

  .morfose-accordion__icon {
    font-size: 14px;
    font-weight: 400;
    line-height: 1;
    transition: transform 0.3s;
    color: #666;
  }

  .morfose-accordion__item.open .morfose-accordion__icon {
    transform: rotate(180deg);
  }

  .morfose-accordion__content {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s ease-out;
  }

  .morfose-accordion__content-inner {
    padding: 0 0 20px 0;
    font-size: 13px;
    line-height: 1.8;
    color: #555;
  }

  .morfose-accordion__content-inner p {
    margin: 0 0 14px 0;
  }

  .morfose-accordion__content-inner p:last-child {
    margin-bottom: 0;
  }

  /* ========================================
     BOTTOM USP ICONS (Full Width)
     ======================================== */
  
  .morfose-product__usp-bottom {
    display: flex;
    justify-content: center;
    gap: 80px;
    padding: 50px 0;
    margin-top: 40px;
    border-top: 1px solid #e5e5e5;
  }

  @media (max-width: 767px) {
    .morfose-product__usp-bottom {
      flex-wrap: wrap;
      gap: 30px;
      justify-content: space-around;
    }
  }

  .morfose-product__usp-item-bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 12px;
  }

  .morfose-product__usp-icon-bottom {
    width: 48px;
    height: 48px;
  }

  .morfose-product__usp-icon-bottom svg {
    width: 100%;
    height: 100%;
    stroke: #333;
    stroke-width: 1;
    fill: none;
  }

  .morfose-product__usp-text-bottom {
    font-size: 10px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: #333;
    line-height: 1.4;
  }

  /* ========================================
     MOBILE ADJUSTMENTS
     ======================================== */
  
  @media (max-width: 991px) {
    .morfose-product {
      padding: 15px 15px 40px;
    }

    .morfose-product__left {
      text-align: center;
    }

    .morfose-product__badge {
      margin: 0 auto;
    }

    .morfose-product__cta-btn {
      margin: 0 auto;
    }

    .morfose-product__usp-left {
      justify-content: center;
    }

    .morfose-product__gallery-nav {
      width: 40px;
      height: 40px;
    }

    .morfose-product__gallery-nav svg {
      width: 16px;
      height: 16px;
    }
  }
</style>

<div class="morfose-product" data-js-product-clone-id="footbar">
  
  <!-- Breadcrumb -->
  {%- assign breadcrumb_collection = collection | default: product.collections.first -%}
  <div class="morfose-product__breadcrumb">
    <a href="{{ routes.root_url }}">Home</a>
    <span>›</span>
    {%- if breadcrumb_collection -%}
      <a href="{{ breadcrumb_collection.url }}">{{ breadcrumb_collection.title }}</a>
      <span>›</span>
    {%- endif -%}
    <span>{{ product.title }}</span>
  </div>

  <div class="morfose-product__grid">
    
    <!-- LEFT COLUMN - Title & Info -->
    <div class="morfose-product__left">
      
      {%- if product.metafields.custom.badge_text != blank -%}
        <span class="morfose-product__badge">{{ product.metafields.custom.badge_text }}</span>
      {%- elsif product.tags contains 'bestseller' -%}
        <span class="morfose-product__badge">Bestseller</span>
      {%- elsif product.tags contains 'new' -%}
        <span class="morfose-product__badge">New</span>
      {%- endif -%}

      <h1 class="morfose-product__title">{{ product.title }}</h1>

      {%- if section.settings.show_short_description and product.metafields.custom.short_description != blank -%}
        <p class="morfose-product__subtitle">{{ product.metafields.custom.short_description }}</p>
      {%- elsif product.description != blank -%}
        <p class="morfose-product__subtitle">{{ product.description | strip_html | truncate: 120 }}</p>
      {%- endif -%}

      <button type="button" class="morfose-product__cta-btn" onclick="document.querySelector('.morfose-product__add-btn').scrollIntoView({behavior: 'smooth'})">
        Try It Now
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </button>

      <!-- USP Icons - Left Side -->
      {%- if section.settings.show_usp_icons -%}
        <div class="morfose-product__usp-left">
          {%- for block in section.blocks -%}
            {%- if block.type == 'usp_icon' -%}
              <div class="morfose-product__usp-item-left" {{ block.shopify_attributes }}>
                <div class="morfose-product__usp-icon-left">
                  <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    {%- case block.settings.icon -%}
                      {%- when 'cruelty_free' -%}
                        <circle cx="12" cy="12" r="10"/>
                        <path d="M8 10c0-2 1-3 2-3M16 10c0-2-1-3-2-3"/>
                        <circle cx="9" cy="11" r="1" fill="#333"/>
                        <circle cx="15" cy="11" r="1" fill="#333"/>
                        <path d="M10 15c1 1 3 1 4 0"/>
                      {%- when 'vegan' -%}
                        <path d="M12 21c0-9 7-13 9-15-1.5 3-3 9-3 15"/>
                        <path d="M12 21c0-9-7-13-9-15 1.5 3 3 9 3 15"/>
                        <path d="M12 21V10"/>
                      {%- when 'dermatologically_tested' -%}
                        <circle cx="12" cy="12" r="10"/>
                        <path d="M8 8l2 2M16 8l-2 2"/>
                        <circle cx="9" cy="11" r="1.5" fill="#333"/>
                        <circle cx="15" cy="11" r="1.5" fill="#333"/>
                        <path d="M9 16c1.5 2 4.5 2 6 0"/>
                      {%- when 'made_in_turkey' -%}
                        <image href="{{ 'turkey-flag.png' | asset_url }}" x="0" y="0" width="24" height="24" preserveAspectRatio="xMidYMid meet"/>
                      {%- when 'paraben_free' -%}
                        <circle cx="12" cy="12" r="10"/>
                        <path d="M6 6l12 12" stroke-width="2"/>
                        <text x="12" y="14" text-anchor="middle" font-size="8" font-weight="600" fill="#333" stroke="none">P</text>
                      {%- else -%}
                        <circle cx="12" cy="12" r="10"/>
                        <path d="M9 12l2 2 4-4"/>
                    {%- endcase -%}
                  </svg>
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

    </div>

    <!-- CENTER COLUMN - Gallery -->
    <div class="morfose-product__gallery">
      <div class="morfose-product__gallery-main">
        
        {%- if product.media.size > 1 -%}
          <button class="morfose-product__gallery-nav morfose-product__gallery-prev" onclick="morfoseGalleryPrev()">
            <svg viewBox="0 0 24 24">
              <path d="M15 18l-6-6 6-6"/>
            </svg>
          </button>
        {%- endif -%}

        {%- assign first_image = product.featured_media | default: product.media[0] -%}
        {%- if first_image -%}
          <img 
            class="morfose-product__main-image" 
            src="{{ first_image | image_url: width: 1200 }}" 
            alt="{{ first_image.alt | escape | default: product.title }}"
            id="morfose-main-image"
            data-media-id="{{ first_image.id }}"
            width="1200"
            height="{{ 1200 | divided_by: first_image.aspect_ratio | round }}"
            loading="eager"
          >
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'morfose-product__main-image' }}
        {%- endif -%}

        {%- if product.media.size > 1 -%}
          <button class="morfose-product__gallery-nav morfose-product__gallery-next" onclick="morfoseGalleryNext()">
            <svg viewBox="0 0 24 24">
              <path d="M9 18l6-6-6-6"/>
            </svg>
          </button>
        {%- endif -%}

      </div>

      {%- if product.media.size > 1 -%}
        <div class="morfose-product__thumbnails">
          {%- for media in product.media -%}
            {%- if media.media_type == 'image' -%}
              <img 
                class="morfose-product__thumbnail{% if forloop.first %} active{% endif %}" 
                src="{{ media | image_url: width: 200 }}" 
                alt="{{ media.alt | escape | default: product.title }}"
                data-full-src="{{ media | image_url: width: 1200 }}"
                data-media-id="{{ media.id }}"
                width="200"
                height="{{ 200 | divided_by: media.aspect_ratio | round }}"
                loading="lazy"
              >
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <!-- RIGHT COLUMN - Product Info -->
    <div class="morfose-product__right">
      
      <!-- Variant Name Display -->
      {%- unless product.has_only_default_variant -%}
        <p class="morfose-product__variant-name" id="morfose-variant-name">{{ current_variant.title }}</p>
      {%- endunless -%}

      <!-- Product Form -->
      {%- form 'product', product, id: 'morfose-product-form', data-product-form: '' -%}
        
        {%- if product.has_only_default_variant == false -%}
          <div class="morfose-product__variants">
            {%- for option in product.options_with_values -%}
              <div class="morfose-product__option">
                <label class="morfose-product__option-label">{{ option.name }}</label>
                <div class="morfose-product__option-values">
                  {%- for value in option.values -%}
                    {%- if option.name == 'Color' or option.name == 'Colour' -%}
                      <button 
                        type="button" 
                        class="morfose-product__color-swatch{% if option.selected_value == value %} selected{% endif %}"
                        data-option-index="{{ forloop.parentloop.index0 }}"
                        data-value="{{ value }}"
                        style="background-color: {{ value | handleize }};"
                        title="{{ value }}"
                        onclick="morfoseSelectOption(this)"
                      ></button>
                    {%- else -%}
                      <button 
                        type="button" 
                        class="morfose-product__option-btn{% if option.selected_value == value %} selected{% endif %}"
                        data-option-index="{{ forloop.parentloop.index0 }}"
                        data-value="{{ value }}"
                        onclick="morfoseSelectOption(this)"
                      >
                        {{ value }}
                      </button>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <!-- Price - Large & Standalone -->
        <div class="morfose-product__price-wrapper">
          <span class="morfose-product__price" id="morfose-price">{{ current_variant.price | money }}</span>
          {%- if current_variant.compare_at_price > current_variant.price -%}
            <span class="morfose-product__compare-price" id="morfose-compare-price">{{ current_variant.compare_at_price | money }}</span>
          {%- endif -%}
        </div>

        <!-- Add to Cart - Large Buttons at Bottom -->
        <div class="morfose-product__actions-wrapper">
          <div class="morfose-product__actions">
            <button 
              type="submit" 
              name="add" 
              class="morfose-product__add-btn"
              data-js-product-button-add-to-cart
              data-js-button-add-to-cart-clone-id="footbar"
              {% unless current_variant.available %}disabled{% endunless %}
            >
              {%- if current_variant.available -%}
                Add to Bag
              {%- else -%}
                Sold Out
              {%- endif -%}
            </button>

            <button type="button" class="morfose-product__wishlist-btn" title="Add to Wishlist">
              <svg viewBox="0 0 24 24">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
              </svg>
            </button>
          </div>

          <div class="morfose-product__quantity-row">
            <div class="morfose-product__quantity">
              <button type="button" class="morfose-product__qty-btn" onclick="morfoseUpdateQty(-1)">−</button>
              <input type="number" name="quantity" value="1" min="1" class="morfose-product__qty-input" id="morfose-qty">
              <button type="button" class="morfose-product__qty-btn" onclick="morfoseUpdateQty(1)">+</button>
            </div>
          </div>
        </div>

        <select name="id" id="morfose-variant-select" style="display: none;">
          {%- for variant in product.variants -%}
            <option 
              value="{{ variant.id }}"
              {% if variant == current_variant %}selected{% endif %}
              data-available="{{ variant.available }}"
              data-price="{{ variant.price | money }}"
              data-compare-price="{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money }}{% endif %}"
              {% if variant.featured_media %}data-image="{{ variant.featured_media | image_url: width: 1200 }}"{% endif %}
            >
              {{ variant.title }}
            </option>
          {%- endfor -%}
        </select>
      {%- endform -%}

      <!-- Accordion Tabs -->
      {%- if section.settings.show_accordion -%}
        <div class="morfose-product__accordion">
          
          {%- if section.settings.show_description and product.description != blank -%}
            <div class="morfose-accordion__item">
              <div class="morfose-accordion__header" onclick="morfoseToggleAccordion(this)">
                <h3 class="morfose-accordion__title">{{ section.settings.description_title | default: 'Description' }}</h3>
                <span class="morfose-accordion__icon">▼</span>
              </div>
              <div class="morfose-accordion__content">
                <div class="morfose-accordion__content-inner">
                  {{ product.description }}
                </div>
              </div>
            </div>
          {%- endif -%}

          {%- if product.metafields.custom.test != blank -%}
            <div class="morfose-accordion__item">
              <div class="morfose-accordion__header" onclick="morfoseToggleAccordion(this)">
                <h3 class="morfose-accordion__title">Test</h3>
                <span class="morfose-accordion__icon">▼</span>
              </div>
              <div class="morfose-accordion__content">
                <div class="morfose-accordion__content-inner">
                  {{ product.metafields.custom.test | metafield_tag }}
                </div>
              </div>
            </div>
          {%- endif -%}

          {%- if product.metafields.custom.results != blank -%}
            <div class="morfose-accordion__item">
              <div class="morfose-accordion__header" onclick="morfoseToggleAccordion(this)">
                <h3 class="morfose-accordion__title">Results</h3>
                <span class="morfose-accordion__icon">▼</span>
              </div>
              <div class="morfose-accordion__content">
                <div class="morfose-accordion__content-inner">
                  {{ product.metafields.custom.results | metafield_tag }}
                </div>
              </div>
            </div>
          {%- endif -%}

          {%- if section.settings.show_how_to_use and product.metafields.custom.how_to_use != blank -%}
            <div class="morfose-accordion__item">
              <div class="morfose-accordion__header" onclick="morfoseToggleAccordion(this)">
                <h3 class="morfose-accordion__title">{{ section.settings.how_to_use_title | default: 'How to Use' }}</h3>
                <span class="morfose-accordion__icon">▼</span>
              </div>
              <div class="morfose-accordion__content">
                <div class="morfose-accordion__content-inner">
                  {{ product.metafields.custom.how_to_use | metafield_tag }}
                </div>
              </div>
            </div>
          {%- endif -%}

          {%- if product.metafields.custom.pack != blank -%}
            <div class="morfose-accordion__item">
              <div class="morfose-accordion__header" onclick="morfoseToggleAccordion(this)">
                <h3 class="morfose-accordion__title">Pack</h3>
                <span class="morfose-accordion__icon">▼</span>
              </div>
              <div class="morfose-accordion__content">
                <div class="morfose-accordion__content-inner">
                  {{ product.metafields.custom.pack | metafield_tag }}
                </div>
              </div>
            </div>
          {%- endif -%}

          {%- if section.settings.show_ingredients and product.metafields.custom.ingredients != blank -%}
            <div class="morfose-accordion__item">
              <div class="morfose-accordion__header" onclick="morfoseToggleAccordion(this)">
                <h3 class="morfose-accordion__title">{{ section.settings.ingredients_title | default: 'Ingredient List' }}</h3>
                <span class="morfose-accordion__icon">▼</span>
              </div>
              <div class="morfose-accordion__content">
                <div class="morfose-accordion__content-inner">
                  {{ product.metafields.custom.ingredients | metafield_tag }}
                </div>
              </div>
            </div>
          {%- endif -%}

          {%- for block in section.blocks -%}
            {%- if block.type == 'accordion_tab' and block.settings.title != blank -%}
              <div class="morfose-accordion__item" {{ block.shopify_attributes }}>
                <div class="morfose-accordion__header" onclick="morfoseToggleAccordion(this)">
                  <h3 class="morfose-accordion__title">{{ block.settings.title }}</h3>
                  <span class="morfose-accordion__icon">▼</span>
                </div>
                <div class="morfose-accordion__content">
                  <div class="morfose-accordion__content-inner">
                    {%- if block.settings.content != blank -%}
                      {{ block.settings.content }}
                    {%- elsif block.settings.page != blank -%}
                      {{ block.settings.page.content }}
                    {%- endif -%}
                  </div>
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}

        </div>
      {%- endif -%}

    </div>
  </div>

  <!-- Bottom USP Icons -->
  {%- if section.settings.show_bottom_usp -%}
    <div class="morfose-product__usp-bottom">
      {%- for block in section.blocks -%}
        {%- if block.type == 'bottom_usp' -%}
          <div class="morfose-product__usp-item-bottom" {{ block.shopify_attributes }}>
            <div class="morfose-product__usp-icon-bottom">
              <svg viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
                {%- case block.settings.icon -%}
                  {%- when 'weight' -%}
                    <path d="M24 8L8 16v16l16 8 16-8V16L24 8z"/>
                    <path d="M24 24v16M8 16l16 8 16-8"/>
                  {%- when 'made_in_turkey' -%}
                    <image href="{{ 'turkey-flag.png' | asset_url }}" x="0" y="0" width="48" height="48" preserveAspectRatio="xMidYMid meet"/>
                  {%- when 'shelf_life' -%}
                    <rect x="10" y="6" width="28" height="36" rx="2"/>
                    <path d="M10 14h28"/>
                    <text x="24" y="32" text-anchor="middle" font-size="12" fill="#333" stroke="none">{{ block.settings.text | split: ' ' | first }}</text>
                  {%- else -%}
                    <circle cx="24" cy="24" r="18"/>
                    <path d="M18 24l4 4 8-8"/>
                {%- endcase -%}
              </svg>
            </div>
            <span class="morfose-product__usp-text-bottom">{{ block.settings.text }}</span>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}

</div>

<script>
(function() {
  // ========================================
  // MORFOSE GALLERY - Fixed Version
  // ========================================
  
  let currentIndex = 0;
  let thumbnails = [];
  let mainImage = null;
  
  // Initialize when DOM is ready
  function initGallery() {
    mainImage = document.getElementById('morfose-main-image');
    thumbnails = Array.from(document.querySelectorAll('.morfose-product__thumbnail'));
    
    if (!mainImage) {
      console.warn('Morfose Gallery: Main image not found');
      return;
    }
    
    // Find initial active index
    thumbnails.forEach(function(thumb, index) {
      if (thumb.classList.contains('active')) {
        currentIndex = index;
      }
    });
    
    // Bind click events to thumbnails
    thumbnails.forEach(function(thumb, index) {
      thumb.addEventListener('click', function(e) {
        e.preventDefault();
        changeImage(index);
      });
    });
    
    console.log('Morfose Gallery initialized with', thumbnails.length, 'images');
  }
  
  // Change main image
  function changeImage(index) {
    if (!mainImage || thumbnails.length === 0) return;
    if (index < 0 || index >= thumbnails.length) return;
    
    currentIndex = index;
    const thumb = thumbnails[index];
    const fullSrc = thumb.getAttribute('data-full-src');
    
    if (fullSrc) {
      mainImage.src = fullSrc;
      mainImage.alt = thumb.alt || '';
    }
    
    // Update active state - remove from ALL, add to current
    thumbnails.forEach(function(t) {
      t.classList.remove('active');
    });
    thumb.classList.add('active');
  }
  
  // Gallery Navigation - Previous
  window.morfoseGalleryPrev = function() {
    if (thumbnails.length === 0) return;
    const newIndex = (currentIndex - 1 + thumbnails.length) % thumbnails.length;
    changeImage(newIndex);
  };
  
  // Gallery Navigation - Next
  window.morfoseGalleryNext = function() {
    if (thumbnails.length === 0) return;
    const newIndex = (currentIndex + 1) % thumbnails.length;
    changeImage(newIndex);
  };
  
  // Expose changeImage for external use
  window.morfoseChangeImage = function(thumbElement) {
    const index = thumbnails.indexOf(thumbElement);
    if (index !== -1) {
      changeImage(index);
    }
  };
  
  // ========================================
  // QUANTITY
  // ========================================
  
  window.morfoseUpdateQty = function(change) {
    const input = document.getElementById('morfose-qty');
    if (!input) return;
    let value = parseInt(input.value) || 1;
    value += change;
    if (value < 1) value = 1;
    input.value = value;
  };
  
  // ========================================
  // VARIANT SELECTION - Fixed Version
  // ========================================
  
  // Store variant data
  const variantData = {};
  
  function initVariants() {
    const select = document.getElementById('morfose-variant-select');
    if (!select) return;
    
    // Build variant data map
    Array.from(select.options).forEach(function(option) {
      variantData[option.value] = {
        title: option.textContent.trim(),
        available: option.getAttribute('data-available') === 'true',
        price: option.getAttribute('data-price'),
        comparePrice: option.getAttribute('data-compare-price'),
        image: option.getAttribute('data-image')
      };
    });
  }
  
  window.morfoseSelectOption = function(btn) {
    // Update selected state for this option group only
    const optionValues = btn.parentElement;
    const buttons = optionValues.querySelectorAll('.morfose-product__option-btn, .morfose-product__color-swatch');
    buttons.forEach(function(b) {
      b.classList.remove('selected');
    });
    btn.classList.add('selected');
    
    // Build selected options array
    const selectedOptions = [];
    document.querySelectorAll('.morfose-product__option').forEach(function(optionGroup) {
      const selected = optionGroup.querySelector('.morfose-product__option-btn.selected, .morfose-product__color-swatch.selected');
      if (selected) {
        selectedOptions.push(selected.getAttribute('data-value'));
      }
    });
    
    // Find matching variant
    const variantSelect = document.getElementById('morfose-variant-select');
    if (!variantSelect) return;
    
    let matchedOption = null;
    Array.from(variantSelect.options).forEach(function(option) {
      const variantTitle = option.textContent.trim();
      const allMatch = selectedOptions.every(function(opt) {
        return variantTitle.indexOf(opt) !== -1;
      });
      if (allMatch) {
        matchedOption = option;
      }
    });
    
    if (matchedOption) {
      variantSelect.value = matchedOption.value;
      
      // Update variant name
      const variantName = document.getElementById('morfose-variant-name');
      if (variantName) {
        variantName.textContent = matchedOption.textContent.trim();
      }
      
      // Update price
      const priceEl = document.getElementById('morfose-price');
      const comparePriceEl = document.getElementById('morfose-compare-price');
      const price = matchedOption.getAttribute('data-price');
      const comparePrice = matchedOption.getAttribute('data-compare-price');
      
      if (priceEl && price) {
        priceEl.textContent = price;
      }
      if (comparePriceEl) {
        if (comparePrice && comparePrice !== price) {
          comparePriceEl.textContent = comparePrice;
          comparePriceEl.style.display = '';
        } else {
          comparePriceEl.style.display = 'none';
        }
      }
      
      // Update button state
      const addBtn = document.querySelector('.morfose-product__add-btn');
      const isAvailable = matchedOption.getAttribute('data-available') === 'true';
      if (addBtn) {
        addBtn.disabled = !isAvailable;
        addBtn.textContent = isAvailable ? 'Add to Bag' : 'Sold Out';
      }
      
      // Update image if variant has specific image
      const variantImage = matchedOption.getAttribute('data-image');
      if (variantImage && mainImage) {
        mainImage.src = variantImage;
        // Find and activate matching thumbnail
        thumbnails.forEach(function(thumb, index) {
          const thumbSrc = thumb.getAttribute('data-full-src');
          if (thumbSrc === variantImage) {
            changeImage(index);
          }
        });
      }
      
      // Update URL without reload
      if (window.history && window.history.replaceState) {
        const url = new URL(window.location.href);
        url.searchParams.set('variant', matchedOption.value);
        window.history.replaceState({}, '', url.toString());
      }
    }
  };
  
  // ========================================
  // ACCORDION
  // ========================================
  
  window.morfoseToggleAccordion = function(header) {
    const item = header.parentElement;
    const content = item.querySelector('.morfose-accordion__content');
    const inner = content.querySelector('.morfose-accordion__content-inner');
    
    if (!content || !inner) return;
    
    const isOpen = item.classList.contains('open');
    
    if (isOpen) {
      item.classList.remove('open');
      content.style.maxHeight = '0';
    } else {
      // Close other open items
      document.querySelectorAll('.morfose-accordion__item.open').forEach(function(openItem) {
        openItem.classList.remove('open');
        const openContent = openItem.querySelector('.morfose-accordion__content');
        if (openContent) openContent.style.maxHeight = '0';
      });
      
      // Open this item
      item.classList.add('open');
      content.style.maxHeight = inner.scrollHeight + 'px';
    }
  };
  
  // ========================================
  // INITIALIZATION
  // ========================================
  
  function init() {
    initGallery();
    initVariants();
    
    // Ensure only one thumbnail is active on load
    const activeThumbs = document.querySelectorAll('.morfose-product__thumbnail.active');
    if (activeThumbs.length > 1) {
      // Keep only the first one active
      for (let i = 1; i < activeThumbs.length; i++) {
        activeThumbs[i].classList.remove('active');
      }
    }
  }
  
  // Run on DOM ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
  
})();
</script>

<!-- Sticky Add to Cart Bar -->
<div class="morfose-sticky-bar" id="morfose-sticky-bar">
  <div class="morfose-sticky-bar__inner">
    <div class="morfose-sticky-bar__image">
      {%- assign sticky_image = product.featured_media | default: product.media[0] -%}
      {%- if sticky_image -%}
        <img 
          src="{{ sticky_image | image_url: width: 80 }}" 
          alt="{{ product.title | escape }}"
          width="80"
          height="{{ 80 | divided_by: sticky_image.aspect_ratio | round }}"
          loading="lazy"
        >
      {%- endif -%}
    </div>
    <div class="morfose-sticky-bar__info">
      <h4 class="morfose-sticky-bar__title">{{ product.title }}</h4>
      <span class="morfose-sticky-bar__price" id="morfose-sticky-price">{{ current_variant.price | money }}</span>
    </div>
    <div class="morfose-sticky-bar__actions">
      <button type="button" class="morfose-sticky-bar__btn" id="morfose-sticky-add-btn" {% unless current_variant.available %}disabled{% endunless %}>
        <span>{%- if current_variant.available -%}Add to Bag{%- else -%}Sold Out{%- endif -%}</span>
      </button>
    </div>
  </div>
</div>

<style>
  .morfose-sticky-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: #fff;
    box-shadow: 0 -4px 20px rgba(0,0,0,0.15);
    z-index: 999;
    transform: translateY(100%);
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    border-top: 3px solid #F36703;
  }

  .morfose-sticky-bar.visible {
    transform: translateY(0);
  }

  .morfose-sticky-bar__inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 15px 25px;
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .morfose-sticky-bar__image {
    width: 60px;
    height: 60px;
    flex-shrink: 0;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    border: 2px solid #f5f5f5;
  }

  .morfose-sticky-bar__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .morfose-sticky-bar__info {
    flex: 1;
    min-width: 0;
  }

  .morfose-sticky-bar__title {
    font-size: 15px;
    font-weight: 600;
    margin: 0 0 6px 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    color: #000;
  }

  .morfose-sticky-bar__price {
    font-size: 20px;
    font-weight: 700;
    color: #F36703;
  }

  .morfose-sticky-bar__actions {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .morfose-sticky-bar__btn {
    background: #000;
    color: #fff;
    border: none;
    padding: 16px 40px;
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    cursor: pointer;
    transition: background 0.2s;
    position: relative;
    overflow: hidden;
  }

  .morfose-sticky-bar__btn span {
    position: relative;
    z-index: 1;
  }

  /* Loading progress bar - hidden by default */
  .morfose-sticky-bar__btn::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0%;
    height: 3px;
    background: #F36703;
    transition: none;
  }

  .morfose-sticky-bar__btn.loading::after {
    animation: stickyBtnLoading 1.5s ease-in-out infinite;
  }

  @keyframes stickyBtnLoading {
    0% {
      left: 0;
      width: 0%;
    }
    50% {
      left: 0;
      width: 100%;
    }
    100% {
      left: 100%;
      width: 0%;
    }
  }

  .morfose-sticky-bar__btn:hover {
    background: #333;
  }

  .morfose-sticky-bar__btn:disabled {
    background: #ccc;
    cursor: not-allowed;
  }

  .morfose-sticky-bar__btn:disabled:hover {
    background: #ccc;
  }

  /* Pulse animation on appear */
  .morfose-sticky-bar.visible .morfose-sticky-bar__btn {
    animation: stickyPulse 0.6s ease-out;
  }

  @keyframes stickyPulse {
    0% { transform: scale(0.95); }
    50% { transform: scale(1.02); }
    100% { transform: scale(1); }
  }

  @media (max-width: 768px) {
    .morfose-sticky-bar__inner {
      padding: 12px 15px;
      gap: 12px;
    }

    .morfose-sticky-bar__image {
      width: 50px;
      height: 50px;
    }

    .morfose-sticky-bar__title {
      font-size: 13px;
      margin-bottom: 4px;
    }

    .morfose-sticky-bar__price {
      font-size: 16px;
    }

    .morfose-sticky-bar__btn {
      padding: 14px 24px;
      font-size: 12px;
      letter-spacing: 1px;
    }
  }

  @media (max-width: 480px) {
    .morfose-sticky-bar__info {
      display: none;
    }

    .morfose-sticky-bar__inner {
      justify-content: space-between;
    }

    .morfose-sticky-bar__btn {
      flex: 1;
      text-align: center;
    }
  }
</style>

<script>
(function() {
  // Sticky Bar Logic
  const stickyBar = document.getElementById('morfose-sticky-bar');
  const addToCartBtn = document.querySelector('.morfose-product__add-btn');
  const stickyAddBtn = document.getElementById('morfose-sticky-add-btn');
  const productForm = document.getElementById('morfose-product-form');
  
  if (!stickyBar || !addToCartBtn) return;

  // Show/hide sticky bar based on scroll position
  function checkStickyBar() {
    const btnRect = addToCartBtn.getBoundingClientRect();
    const isButtonVisible = btnRect.top < window.innerHeight && btnRect.bottom > 0;
    
    if (isButtonVisible) {
      stickyBar.classList.remove('visible');
    } else {
      stickyBar.classList.add('visible');
    }
  }

  // Throttle scroll event
  let ticking = false;
  window.addEventListener('scroll', function() {
    if (!ticking) {
      window.requestAnimationFrame(function() {
        checkStickyBar();
        ticking = false;
      });
      ticking = true;
    }
  });

  // Initial check
  checkStickyBar();

  // Sticky bar button click - add to cart via AJAX and open drawer
  if (stickyAddBtn) {
    stickyAddBtn.addEventListener('click', function() {
      if (stickyAddBtn.disabled) return;
      
      const variantSelect = document.getElementById('morfose-variant-select');
      const quantityInput = document.getElementById('morfose-qty');
      
      const variantId = variantSelect ? variantSelect.value : null;
      const quantity = quantityInput ? parseInt(quantityInput.value) || 1 : 1;
      
      if (!variantId) return;
      
      // Show loading state
      const btnSpan = stickyAddBtn.querySelector('span');
      const originalText = btnSpan.textContent;
      btnSpan.textContent = 'Adding...';
      stickyAddBtn.classList.add('loading');
      stickyAddBtn.disabled = true;
      
      // Add to cart via AJAX
      fetch('/cart/add.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          id: variantId,
          quantity: quantity
        })
      })
      .then(response => response.json())
      .then(data => {
        // Success - open cart drawer
        btnSpan.textContent = 'Added!';
        
        // Open cart drawer - click the cart button which triggers the popup
        setTimeout(function() {
          const cartTrigger = document.querySelector('[data-js-popup-button="cart"]');
          if (cartTrigger) {
            cartTrigger.click();
          }
        }, 300);
        
        // Update cart count if exists
        const cartCountElements = document.querySelectorAll('[data-js-cart-count], .cart-count, .header__cart-count');
        cartCountElements.forEach(el => {
          fetch('/cart.js')
            .then(r => r.json())
            .then(cart => {
              el.textContent = cart.item_count;
            });
        });
        
        // Reset button after delay
        setTimeout(() => {
          stickyAddBtn.classList.remove('loading');
          btnSpan.textContent = originalText;
          stickyAddBtn.disabled = false;
        }, 1500);
      })
      .catch(error => {
        console.error('Error adding to cart:', error);
        stickyAddBtn.classList.remove('loading');
        btnSpan.textContent = 'Error';
        setTimeout(() => {
          btnSpan.textContent = originalText;
          stickyAddBtn.disabled = false;
        }, 1500);
      });
    });
  }

  // Update sticky bar price when variant changes
  const variantSelect = document.getElementById('morfose-variant-select');
  if (variantSelect) {
    variantSelect.addEventListener('change', function() {
      const selectedOption = variantSelect.options[variantSelect.selectedIndex];
      const stickyPrice = document.getElementById('morfose-sticky-price');
      const price = selectedOption.getAttribute('data-price');
      
      if (stickyPrice && price) {
        stickyPrice.textContent = price;
      }

      // Update button state
      const isAvailable = selectedOption.getAttribute('data-available') === 'true';
      if (stickyAddBtn) {
        stickyAddBtn.disabled = !isAvailable;
        stickyAddBtn.textContent = isAvailable ? 'Add to Bag' : 'Sold Out';
      }
    });
  }
})();
</script>

