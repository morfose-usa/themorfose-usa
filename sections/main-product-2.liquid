        }
      ]
    },
    {
      "type": "accordion_tab",
      "name": "Custom Tab",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Tab title",
          "default": "Custom Tab"
        },
        {
          "type": "richtext",
          "id": "content",
