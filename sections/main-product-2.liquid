            { "value": "eco_friendly", "label": "Eco Friendly" }
          ]
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Cruelty Free"
        }
      ]
    },
    {
      "type": "bottom_usp",
      "name": "Bottom USP Icon",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "weight",
