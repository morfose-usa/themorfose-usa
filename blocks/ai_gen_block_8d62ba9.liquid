{% doc %}
  @prompt
    categry text area seo focused
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-category-seo-{{ ai_gen_id }} {
    padding: {{ block.settings.padding_top }}px 0 {{ block.settings.padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-category-seo-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.content_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-category-seo-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-category-seo-content-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    line-height: {{ block.settings.line_height }};
    color: {{ block.settings.text_color }};
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-category-seo-content-{{ ai_gen_id }} p {
    margin: 0 0 {{ block.settings.paragraph_spacing }}px;
  }

  .ai-category-seo-content-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .ai-category-seo-content-{{ ai_gen_id }} h2,
  .ai-category-seo-content-{{ ai_gen_id }} h3,
  .ai-category-seo-content-{{ ai_gen_id }} h4 {
    color: {{ block.settings.heading_color }};
    margin: {{ block.settings.subheading_spacing }}px 0 {{ block.settings.paragraph_spacing }}px;
  }

  .ai-category-seo-content-{{ ai_gen_id }} h2 {
    font-size: {{ block.settings.heading_size | times: 0.8 }}px;
  }

  .ai-category-seo-content-{{ ai_gen_id }} h3 {
    font-size: {{ block.settings.heading_size | times: 0.7 }}px;
  }

  .ai-category-seo-content-{{ ai_gen_id }} h4 {
    font-size: {{ block.settings.heading_size | times: 0.6 }}px;
  }

  .ai-category-seo-content-{{ ai_gen_id }} ul,
  .ai-category-seo-content-{{ ai_gen_id }} ol {
    margin: 0 0 {{ block.settings.paragraph_spacing }}px;
    padding-left: 20px;
  }

  .ai-category-seo-content-{{ ai_gen_id }} li {
    margin-bottom: 8px;
  }

  .ai-category-seo-content-{{ ai_gen_id }} a {
    color: {{ block.settings.link_color }};
    text-decoration: underline;
  }

  .ai-category-seo-content-{{ ai_gen_id }} a:hover {
    color: {{ block.settings.link_hover_color }};
  }

  .ai-category-seo-content-{{ ai_gen_id }} strong,
  .ai-category-seo-content-{{ ai_gen_id }} b {
    font-weight: 600;
  }

  .ai-category-seo-toggle-{{ ai_gen_id }} {
    margin-top: {{ block.settings.paragraph_spacing }}px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-category-seo-button-{{ ai_gen_id }} {
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    border: 1px solid {{ block.settings.button_border_color }};
    padding: 12px 24px;
    font-size: {{ block.settings.text_size }}px;
    cursor: pointer;
    border-radius: {{ block.settings.button_border_radius }}px;
    transition: all 0.3s ease;
  }

  .ai-category-seo-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
  }

  .ai-category-seo-content-collapsed-{{ ai_gen_id }} {
    max-height: {{ block.settings.collapsed_height }}px;
    overflow: hidden;
    position: relative;
  }

  .ai-category-seo-content-collapsed-{{ ai_gen_id }}::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 80px;
    background: linear-gradient(to bottom, transparent, {{ block.settings.background_color }});
  }

  @media screen and (max-width: 749px) {
    .ai-category-seo-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-category-seo-content-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<category-seo-{{ ai_gen_id }} class="ai-category-seo-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-category-seo-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-category-seo-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    {% if block.settings.content != blank %}
      <div 
        class="ai-category-seo-content-{{ ai_gen_id }} {% if block.settings.enable_read_more %}ai-category-seo-content-collapsed-{{ ai_gen_id }}{% endif %}"
        data-content
      >
        {{ block.settings.content }}
      </div>

      {% if block.settings.enable_read_more %}
        <div class="ai-category-seo-toggle-{{ ai_gen_id }}">
          <button 
            class="ai-category-seo-button-{{ ai_gen_id }}"
            data-toggle-button
            aria-expanded="false"
          >
            {{ block.settings.read_more_text }}
          </button>
        </div>
      {% endif %}
    {% else %}
      <div class="ai-category-seo-content-{{ ai_gen_id }}">
        <p style="color: #999; font-style: italic;">Add SEO-optimized content for this category to improve search rankings and provide valuable information to customers.</p>
      </div>
    {% endif %}
  </div>
</category-seo-{{ ai_gen_id }}>

<script>
  (function() {
    class CategorySeo{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.content = this.querySelector('[data-content]');
        this.toggleButton = this.querySelector('[data-toggle-button]');
        
        if (this.toggleButton && this.content) {
          this.isExpanded = false;
          this.readMoreText = '{{ block.settings.read_more_text }}';
          this.readLessText = '{{ block.settings.read_less_text }}';
          
          this.toggleButton.addEventListener('click', () => {
            this.toggleContent();
          });
        }
      }

      toggleContent() {
        this.isExpanded = !this.isExpanded;
        
        if (this.isExpanded) {
          this.content.classList.remove('ai-category-seo-content-collapsed-{{ ai_gen_id }}');
          this.toggleButton.textContent = this.readLessText;
          this.toggleButton.setAttribute('aria-expanded', 'true');
        } else {
          this.content.classList.add('ai-category-seo-content-collapsed-{{ ai_gen_id }}');
          this.toggleButton.textContent = this.readMoreText;
          this.toggleButton.setAttribute('aria-expanded', 'false');
        }
      }
    }

    customElements.define('category-seo-{{ ai_gen_id }}', CategorySeo{{ ai_gen_id }});
  })();
</script>

