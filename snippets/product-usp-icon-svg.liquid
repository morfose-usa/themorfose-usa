{% comment %}
  USP Icon SVG Snippet
  Usage: {% render 'product-usp-icon-svg', icon: 'cruelty_free', size: 'small' %}
  Sizes: small (24x24), medium (40x40), large (48x48)
{% endcomment %}

{%- case size -%}
  {%- when 'small' -%}
    {%- assign viewbox = '0 0 24 24' -%}
    {%- assign icon_size = '24' -%}
  {%- when 'medium' -%}
    {%- assign viewbox = '0 0 40 40' -%}
    {%- assign icon_size = '40' -%}
  {%- when 'large' -%}
    {%- assign viewbox = '0 0 48 48' -%}
    {%- assign icon_size = '48' -%}
  {%- else -%}
    {%- assign viewbox = '0 0 24 24' -%}
    {%- assign icon_size = '24' -%}
{%- endcase -%}

<svg viewBox="{{ viewbox }}" xmlns="http://www.w3.org/2000/svg" width="{{ icon_size }}" height="{{ icon_size }}">
  {%- case icon -%}
    {%- when 'cruelty_free' -%}
      {%- if size == 'large' -%}
        <circle cx="24" cy="24" r="20"/>
        <path d="M16 20c0-4 2-6 4-6M32 20c0-4-2-6-4-6"/>
        <circle cx="18" cy="22" r="2" fill="#333"/>
        <circle cx="30" cy="22" r="2" fill="#333"/>
        <path d="M20 30c2 2 6 2 8 0"/>
      {%- elsif size == 'medium' -%}
        <circle cx="20" cy="20" r="16"/>
        <path d="M13 16c0-3 1.5-5 3-5M27 16c0-3-1.5-5-3-5"/>
        <circle cx="15" cy="18" r="1.5" fill="#333"/>
        <circle cx="25" cy="18" r="1.5" fill="#333"/>
        <path d="M16 25c1.5 2 5 2 8 0"/>
      {%- else -%}
        <circle cx="12" cy="12" r="10"/>
        <path d="M8 10c0-2 1-3 2-3M16 10c0-2-1-3-2-3"/>
        <circle cx="9" cy="11" r="1" fill="#333"/>
        <circle cx="15" cy="11" r="1" fill="#333"/>
        <path d="M10 15c1 1 3 1 4 0"/>
      {%- endif -%}
      
    {%- when 'vegan' -%}
      {%- if size == 'large' -%}
        <path d="M24 42c0-18 14-26 18-30-3 6-6 18-6 30"/>
        <path d="M24 42c0-18-14-26-18-30 3 6 6 18 6 30"/>
        <path d="M24 42V20"/>
      {%- elsif size == 'medium' -%}
        <path d="M20 35c0-15 12-22 15-25-2.5 5-5 15-5 25"/>
        <path d="M20 35c0-15-12-22-15-25 2.5 5 5 15 5 25"/>
        <path d="M20 35V16"/>
      {%- else -%}
        <path d="M12 21c0-9 7-13 9-15-1.5 3-3 9-3 15"/>
        <path d="M12 21c0-9-7-13-9-15 1.5 3 3 9 3 15"/>
        <path d="M12 21V10"/>
      {%- endif -%}
      
    {%- when 'dermatologically_tested' -%}
      {%- if size == 'large' -%}
        <circle cx="24" cy="24" r="20"/>
        <path d="M16 16l4 4M32 16l-4 4"/>
        <circle cx="18" cy="22" r="3" fill="#333"/>
        <circle cx="30" cy="22" r="3" fill="#333"/>
        <path d="M18 32c3 4 9 4 12 0"/>
      {%- elsif size == 'medium' -%}
        <circle cx="20" cy="20" r="16"/>
        <path d="M13 13l3 3M27 13l-3 3"/>
        <circle cx="15" cy="18" r="2.5" fill="#333"/>
        <circle cx="25" cy="18" r="2.5" fill="#333"/>
        <path d="M15 26c2.5 3 7.5 3 10 0"/>
      {%- else -%}
        <circle cx="12" cy="12" r="10"/>
        <path d="M8 8l2 2M16 8l-2 2"/>
        <circle cx="9" cy="11" r="1.5" fill="#333"/>
        <circle cx="15" cy="11" r="1.5" fill="#333"/>
        <path d="M9 16c1.5 2 4.5 2 6 0"/>
      {%- endif -%}
      
    {%- when 'made_in_turkey' -%}
      {%- comment %} Istanbul Bosphorus Bridge Icon - Soft & Rounded {% endcomment -%}
      {%- if size == 'large' -%}
        {%- comment %} 48x48 {% endcomment -%}
        <!-- Outer oval frame -->
        <ellipse cx="24" cy="24" rx="22" ry="20" fill="none" stroke-width="1.5"/>
        <!-- Left tower with rounded top -->
        <path d="M13 18 L13 34 Q13 35 14 35 L16 35 Q17 35 17 34 L17 18 Q17 16 15 15 Q13 16 13 18" fill="none" stroke-width="1.2"/>
        <!-- Right tower with rounded top -->
        <path d="M31 18 L31 34 Q31 35 32 35 L34 35 Q35 35 35 34 L35 18 Q35 16 33 15 Q31 16 31 18" fill="none" stroke-width="1.2"/>
        <!-- Main suspension cable (elegant curve) -->
        <path d="M15 17 Q24 30 33 17" fill="none" stroke-width="1.3" stroke-linecap="round"/>
        <!-- Bridge deck (rounded) -->
        <path d="M8 33 Q24 36 40 33" fill="none" stroke-width="1.8" stroke-linecap="round"/>
        <!-- Vertical cables (soft) -->
        <line x1="18" y1="21" x2="18" y2="33" stroke-width="0.7" stroke-linecap="round"/>
        <line x1="21" y1="24" x2="21" y2="34" stroke-width="0.7" stroke-linecap="round"/>
        <line x1="24" y1="26" x2="24" y2="34.5" stroke-width="0.7" stroke-linecap="round"/>
        <line x1="27" y1="24" x2="27" y2="34" stroke-width="0.7" stroke-linecap="round"/>
        <line x1="30" y1="21" x2="30" y2="33" stroke-width="0.7" stroke-linecap="round"/>
      {%- elsif size == 'medium' -%}
        {%- comment %} 40x40 {% endcomment -%}
        <!-- Outer oval frame -->
        <ellipse cx="20" cy="20" rx="18" ry="16" fill="none" stroke-width="1.3"/>
        <!-- Left tower -->
        <path d="M11 15 L11 28 Q11 29 12 29 L13 29 Q14 29 14 28 L14 15 Q14 13 12.5 12.5 Q11 13 11 15" fill="none" stroke-width="1"/>
        <!-- Right tower -->
        <path d="M26 15 L26 28 Q26 29 27 29 L28 29 Q29 29 29 28 L29 15 Q29 13 27.5 12.5 Q26 13 26 15" fill="none" stroke-width="1"/>
        <!-- Main suspension cable -->
        <path d="M12.5 14 Q20 25 27.5 14" fill="none" stroke-width="1.1" stroke-linecap="round"/>
        <!-- Bridge deck -->
        <path d="M6 27 Q20 30 34 27" fill="none" stroke-width="1.5" stroke-linecap="round"/>
        <!-- Vertical cables -->
        <line x1="15" y1="17.5" x2="15" y2="27.5" stroke-width="0.6" stroke-linecap="round"/>
        <line x1="17.5" y1="20" x2="17.5" y2="28" stroke-width="0.6" stroke-linecap="round"/>
        <line x1="20" y1="21.5" x2="20" y2="28.5" stroke-width="0.6" stroke-linecap="round"/>
        <line x1="22.5" y1="20" x2="22.5" y2="28" stroke-width="0.6" stroke-linecap="round"/>
        <line x1="25" y1="17.5" x2="25" y2="27.5" stroke-width="0.6" stroke-linecap="round"/>
      {%- else -%}
        {%- comment %} 24x24 {% endcomment -%}
        <!-- Outer oval frame -->
        <ellipse cx="12" cy="12" rx="10.5" ry="9.5" fill="none" stroke-width="1.2"/>
        <!-- Left tower -->
        <path d="M6 9 L6 17 Q6 17.5 6.5 17.5 L7.5 17.5 Q8 17.5 8 17 L8 9 Q8 8 7 7.5 Q6 8 6 9" fill="none" stroke-width="0.9"/>
        <!-- Right tower -->
        <path d="M16 9 L16 17 Q16 17.5 16.5 17.5 L17.5 17.5 Q18 17.5 18 17 L18 9 Q18 8 17 7.5 Q16 8 16 9" fill="none" stroke-width="0.9"/>
        <!-- Main suspension cable -->
        <path d="M7 8.5 Q12 15 17 8.5" fill="none" stroke-width="1" stroke-linecap="round"/>
        <!-- Bridge deck -->
        <path d="M4 16.5 Q12 18.5 20 16.5" fill="none" stroke-width="1.2" stroke-linecap="round"/>
        <!-- Vertical cables -->
        <line x1="9" y1="10.5" x2="9" y2="17" stroke-width="0.5" stroke-linecap="round"/>
        <line x1="12" y1="13" x2="12" y2="17.5" stroke-width="0.5" stroke-linecap="round"/>
        <line x1="15" y1="10.5" x2="15" y2="17" stroke-width="0.5" stroke-linecap="round"/>
      {%- endif -%}
      
    {%- when 'paraben_free' -%}
      {%- if size == 'large' -%}
        <circle cx="24" cy="24" r="20"/>
        <path d="M12 12l24 24" stroke-width="3"/>
        <text x="24" y="28" text-anchor="middle" font-size="16" font-weight="600" fill="#333" stroke="none">P</text>
      {%- elsif size == 'medium' -%}
        <circle cx="20" cy="20" r="16"/>
        <path d="M10 10l20 20" stroke-width="2.5"/>
        <text x="20" y="24" text-anchor="middle" font-size="14" font-weight="600" fill="#333" stroke="none">P</text>
      {%- else -%}
        <circle cx="12" cy="12" r="10"/>
        <path d="M6 6l12 12" stroke-width="2"/>
        <text x="12" y="14" text-anchor="middle" font-size="8" font-weight="600" fill="#333" stroke="none">P</text>
      {%- endif -%}
      
    {%- when 'sulfate_free' -%}
      {%- if size == 'large' -%}
        <circle cx="24" cy="24" r="20"/>
        <path d="M12 12l24 24" stroke-width="3"/>
        <text x="24" y="28" text-anchor="middle" font-size="16" font-weight="600" fill="#333" stroke="none">S</text>
      {%- elsif size == 'medium' -%}
        <circle cx="20" cy="20" r="16"/>
        <path d="M10 10l20 20" stroke-width="2.5"/>
        <text x="20" y="24" text-anchor="middle" font-size="14" font-weight="600" fill="#333" stroke="none">S</text>
      {%- else -%}
        <circle cx="12" cy="12" r="10"/>
        <path d="M6 6l12 12" stroke-width="2"/>
        <text x="12" y="14" text-anchor="middle" font-size="8" font-weight="600" fill="#333" stroke="none">S</text>
      {%- endif -%}
      
    {%- when 'organic' -%}
      {%- if size == 'large' -%}
        <circle cx="24" cy="24" r="20"/>
        <path d="M24 10c-8 4-10 14-4 20 4-10 12-12 16-6"/>
        <path d="M20 34c4-8 2-16-4-18"/>
      {%- elsif size == 'medium' -%}
        <circle cx="20" cy="20" r="16"/>
        <path d="M20 8c-6 3-8 11-3 16 3-8 10-10 13-5"/>
        <path d="M16 28c3-6 2-13-3-15"/>
      {%- else -%}
        <circle cx="12" cy="12" r="10"/>
        <path d="M12 5c-4 2-5 7-2 10 2-5 6-6 8-3"/>
        <path d="M10 17c2-4 1-8-2-9"/>
      {%- endif -%}
      
    {%- when 'eco_friendly' -%}
      {%- if size == 'large' -%}
        <circle cx="24" cy="24" r="20"/>
        <path d="M24 8v28M16 16l8 8 8-8M16 24l8 8 8-8"/>
      {%- elsif size == 'medium' -%}
        <circle cx="20" cy="20" r="16"/>
        <path d="M20 6v24M13 13l7 7 7-7M13 20l7 7 7-7"/>
      {%- else -%}
        <circle cx="12" cy="12" r="10"/>
        <path d="M12 4v14M8 8l4 4 4-4M8 12l4 4 4-4"/>
      {%- endif -%}
      
    {%- when 'weight' -%}
      {%- if size == 'large' -%}
        <path d="M24 8L8 16v16l16 8 16-8V16L24 8z"/>
        <path d="M24 24v16M8 16l16 8 16-8"/>
      {%- elsif size == 'medium' -%}
        <path d="M20 6L6 13v14l14 7 14-7V13L20 6z"/>
        <path d="M20 20v14M6 13l14 7 14-7"/>
      {%- else -%}
        <path d="M12 4L4 8v8l8 4 8-4V8L12 4z"/>
        <path d="M12 12v8M4 8l8 4 8-4"/>
      {%- endif -%}
      
    {%- when 'shelf_life' -%}
      {%- if size == 'large' -%}
        <rect x="10" y="6" width="28" height="36" rx="2"/>
        <path d="M10 14h28"/>
        <text x="24" y="32" text-anchor="middle" font-size="12" fill="#333" stroke="none">{{ text | split: ' ' | first }}</text>
      {%- elsif size == 'medium' -%}
        <rect x="8" y="5" width="24" height="30" rx="2"/>
        <path d="M8 12h24"/>
        <text x="20" y="26" text-anchor="middle" font-size="10" fill="#333" stroke="none">{{ text | split: ' ' | first }}</text>
      {%- else -%}
        <rect x="4" y="2" width="16" height="20" rx="1"/>
        <path d="M4 6h16"/>
        <text x="12" y="16" text-anchor="middle" font-size="6" fill="#333" stroke="none">{{ text | split: ' ' | first }}</text>
      {%- endif -%}
      
    {%- else -%}
      {%- comment %} Default checkmark icon {% endcomment -%}
      {%- if size == 'large' -%}
        <circle cx="24" cy="24" r="20"/>
        <path d="M16 24l6 6 12-12"/>
      {%- elsif size == 'medium' -%}
        <circle cx="20" cy="20" r="16"/>
        <path d="M13 20l5 5 10-10"/>
      {%- else -%}
        <circle cx="12" cy="12" r="10"/>
        <path d="M8 12l3 3 5-5"/>
      {%- endif -%}
  {%- endcase -%}
</svg>
