{%- comment -%}
  SEO fallback: shown only inside <noscript>. When JS is on, this is not rendered
  (no duplicate heading). When JS is off or bot does not run JS, crawlers see
  title + description in static HTML.
{%- endcomment -%}
{%- if template.name == 'collection' and collection -%}
<div class="collection-page-heading collection-heading-seo-static">
  <div class="collection-page-heading__wrapper">
    <div class="container mt-15 mb-15">
      <h1 class="mb-10 text-center text-lg-left">{% if collection.handle == 'all' %}{{ 'collection_template.all_products_title' | t }}{% else %}{{ collection.title }}{% endif %}</h1>
      {%- if collection.description != blank -%}
        <div class="rte fs">
          {% render 'parse-for-icons' with content: collection.description %}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>
{%- endif -%}
