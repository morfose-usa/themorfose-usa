{%- if settings.product_format_pjpg -%}
    {%- assign image_format = 'pjpg' -%}
{%- else -%}
    {%- assign image_format = null -%}
{%- endif -%}

<style>
*,
*::before,
*::after {
  box-sizing: border-box;
}

/* MAIN LAYOUT */
.cart-container {
  max-width: 1280px;
  margin: auto;
  padding: 20px 20px 120px;
}

.cart-title {
  text-align:center;
  margin: 30px 0;
  font-size: 28px;
  font-weight: 700;
}

/* PRODUCT CARD */
.cart-item {
  position: relative;
  background: #fff;
  border-radius: 14px;
  padding: 20px;
  margin-bottom: 20px;
  border: 1px solid #eee;
  box-shadow: 0 3px 10px rgba(0,0,0,0.04);
}

.cart-item-top {
  display: flex;
  align-items: flex-start;
  gap: 18px;
}

.cart-item-remove {
  position: absolute;
  right: 12px;
  top: 12px;
  color: #aaa;
  cursor: pointer;
  transition: 0.2s;
  font-size: 18px;
}
.cart-item-remove:hover { color: #ff3b3b; }

.cart-item-image {
  width: 110px;
  min-width: 110px;
  border-radius: 10px;
  overflow: hidden;
}

.cart-item-info {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.cart-item-title {
  font-size: 17px;
  font-weight: 600;
}

.cart-item-variant {
  color: #666;
  font-size: 14px;
}

/* PRODUCT BOTTOM */
.cart-item-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 14px;
  margin-top: 20px;
  padding-top: 12px;
  border-top: 1px solid #eee;
}

.cart-price,
.cart-total {
  font-size: 16px;
  font-weight: 700;
}

/* QUANTITY */
.qty-wrapper {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
}

.qty-btn {
  width: 40px;
  height: 40px;
  border-radius: 12px;
  border: 1px solid #ddd;
  background: #fafafa;
  font-size: 20px;
  font-weight: 600;
  cursor: pointer;
  display:flex;
  align-items:center;
  justify-content:center;
}

.qty-input {
  width: 60px;
  height: 40px;
  border: 1px solid #ddd;
  border-radius: 12px;
  text-align:center;
  font-size: 16px;
  padding: 0;
  margin-bottom: 0 !important;
}

/* SIDEBAR */
.summary-box {
  background: #fff;
  border-radius: 16px;
  padding: 25px;
  border: 1px solid #eee;
  box-shadow: 0 3px 15px rgba(0,0,0,0.06);
  position: sticky;
  top: 120px;
}

.summary-header {
  font-size: 20px;
  font-weight: 700;
  margin-bottom: 15px;
}

.summary-row {
  display: flex;
  justify-content: space-between;
  margin: 8px 0;
}

.summary-total {
  font-size: 22px;
  font-weight: 800;
  margin-top: 15px;
}

/* SHIPPING ACCORDION */
.shipping-accordion {
  margin-top: 25px;
  border-top: 1px dashed #ddd;
  padding-top: 20px;
}

.shipping-accordion-header {
  font-size: 16px;
  font-weight: 600;
  cursor: pointer;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.shipping-arrow {
  display:inline-block;
  transition: .2s;
}

.shipping-accordion-content {
  display: none;
  margin-top: 15px;
  animation: fadeIn .25s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* MODERN BUTTONS */
.btn-modern {
  background: #111;
  color: #fff !important;
  border-radius: 12px;
  padding: 12px 20px;
  font-size: 16px;
  font-weight: 600;
  border: none;
  width: 100%;
  text-align: center;
  transition: 0.2s ease-in-out;
  cursor:pointer;
}

.btn-modern:hover {
  background: #000;
  transform: translateY(-1px);
}

.btn-modern:active {
  transform: scale(0.98);
}

/* Shipping Get Rates button */
#shipping-calculator .get-rates {
  display:inline-block;
  cursor:pointer;
  padding: 10px 18px;
  background:#111;
  color:#fff !important;
  border-radius: 10px;
  font-weight:600;
  transition: .2s;
}

#shipping-calculator .get-rates:hover {
  background:#000;
  transform: translateY(-1px);
}

/* MOBILE LAYOUT FIXES */
@media(max-width: 768px){

  .cart-item {
    padding: 16px;
  }

  .cart-item-top {
    gap: 12px;
  }

  .cart-item-image {
    width: 80px;
    min-width: 80px;
  }

  .cart-item-info {
    padding-right: 28px; /* delete ikonuyla çakışmasın */
  }

  .cart-item-bottom {
    margin-top: 14px;
    padding-top: 10px;
    gap: 8px;
  }

  .cart-price {
    min-width: 65px;
    text-align: left;
    font-size: 15px;
  }

  .cart-total {
    min-width: 70px;
    text-align: right;
    font-size: 15px;
  }

  .qty-wrapper {
    flex: 1;
    justify-content: center;
  }

  .qty-btn {
    width: 38px;
    height: 38px;
    font-size: 18px;
  }

  .qty-input {
    width: 55px;
    height: 38px;
    font-size: 15px;
  }

  .summary-box { display:none; }

  .mobile-checkout-bar{
    position:fixed;
    bottom:0;
    left:0; right:0;
    background:#fff;
    box-shadow:0 -3px 8px rgba(0,0,0,0.12);
    padding:15px 20px;
    display:flex; justify-content:space-between; align-items:center;
    z-index:9999;
  }

  .mobile-checkout-bar .btn-modern {
    width:auto;
    padding:12px 22px;
  }

  .cart-container { padding-bottom:160px; }
}
</style>

<script>
document.addEventListener("DOMContentLoaded", function(){

  /* Auto update quantity */
  const form = document.querySelector("form[action='/cart']");
  const inputs = document.querySelectorAll(".qty-input");
  const buttons = document.querySelectorAll(".qty-btn");

  inputs.forEach(i=> i.addEventListener("change", ()=> form.submit()));

  buttons.forEach(btn=>{
    btn.addEventListener("click", ()=>{
      const input = btn.parentElement.querySelector(".qty-input");
      let val = parseInt(input.value);

      if(btn.dataset.type === "plus") val++;
      if(btn.dataset.type === "minus" && val > 1) val--;

      input.value = val;
      form.submit();
    });
  });

  /* Shipping accordion toggle */
  const header = document.querySelector(".shipping-accordion-header");
  const content = document.querySelector(".shipping-accordion-content");
  const icon = document.querySelector(".shipping-arrow");

  if(header && content && icon){
    header.addEventListener("click", ()=>{
      const isOpen = content.style.display === "block";
      content.style.display = isOpen ? "none" : "block";
      icon.style.transform = isOpen ? "rotate(0deg)" : "rotate(90deg)";
    });
  }
});
</script>


<div class="cart-container">

{%- if cart.item_count > 0 -%}

  <h1 class="cart-title">{{ 'cart.general.title' | t }}</h1>

  <form action="/cart" method="post">

    <div class="row">
      <div class="col-lg-8">

        {%- for item in cart.items -%}
        <div class="cart-item">

          <div class="cart-item-top">
            <a href="/cart/change?line={{ forloop.index }}&quantity=0" class="cart-item-remove">
              {% render 'icon-theme-165' %}
            </a>

            <div class="cart-item-image">
              {% if item.image != blank %}
                {% render 'rimage' with image: item.image size:'200x' format:image_format image_class:'w-100' %}
              {% endif %}
            </div>

            <div class="cart-item-info">
              <a href="{{ item.url }}" class="cart-item-title">{{ item.product.title }}</a>

              {%- unless item.product.has_only_default_variant -%}
                <span class="cart-item-variant">{{ item.variant.title }}</span>
              {%- endunless -%}
            </div>
          </div>

          <div class="cart-item-bottom">
            <div class="cart-price">
              {% include 'product-get-price' with price: item.price compare_at_price: item.original_price current_variant: item available: true %}
            </div>

            <div class="qty-wrapper">
              <button type="button" class="qty-btn" data-type="minus">−</button>
              <input type="number" class="qty-input" name="updates[]" id="updates_{{ item.key }}" value="{{ item.quantity }}" min="1">
              <button type="button" class="qty-btn" data-type="plus">+</button>
            </div>

            <div class="cart-total">
              {% include 'product-get-price' with price: item.line_price compare_at_price: null current_variant: item available: true %}
            </div>
          </div>

        </div>
        {%- endfor -%}

      </div>

      <div class="col-lg-4">

        <div class="summary-box">
          <div class="summary-header">{{ 'cart.general.sidebar_title' | t }}</div>

          <div class="summary-row">
            <span>{{ 'cart.general.subtotal' | t }}</span>
            <span>{{ cart.total_price | money }}</span>
          </div>

          <div class="summary-row">
            <span>{{ 'cart.general.shipping_at_checkout' | t }}</span>
            <span>—</span>
          </div>

          <div class="summary-total">{{ cart.total_price | money }}</div>

          <input type="submit" class="btn-modern mt-20"
                 name="checkout"
                 value="{{ 'cart.general.checkout' | t }}">

          <!-- SHIPPING CALCULATOR -->
          <div class="shipping-accordion">
            <div class="shipping-accordion-header">
              <span>{{ 'cart.general.shipping_calculator_heading' | t }}</span>
              <i class="shipping-arrow">›</i>
            </div>

            <div class="shipping-accordion-content">

              {%- unless settings.shipping_calculator == 'Disabled' -%}
              <div id="shipping-calculator">

                <h3 class="h6 mb-10">{{ 'cart.general.shipping_calculator_heading' | t }}</h3>
                <p class="mb-10">{{ 'cart.general.shipping_calculator_heading_paragraph' | t }}</p>

                <div>
                  <p class="field">
                    <label for="address_country" class="label-required">
                      {{ 'cart.general.shipping_country_title' | t }}
                    </label>
                    <select id="address_country"
                            name="address[country]"
                            data-default="{% if shop.customer_accounts_enabled and customer %}{{ customer.default_address.country }}{% elsif settings.shipping_calculator_default_country != '' %}{{ settings.shipping_calculator_default_country }}{% endif %}">
                      {{ country_option_tags }}
                    </select>
                  </p>

                  <p class="field" id="address_province_container" style="display:none;">
                    <label for="address_province" id="address_province_label" class="label-required text-uppercase">
                      {{ 'cart.general.shipping_province_title' | t }}
                    </label>
                    <select id="address_province" name="address[province]"
                            data-default="{% if shop.customer_accounts_enabled and customer and customer.default_address.province != '' %}{{ customer.default_address.province }}{% endif %}"></select>
                  </p>

                  <p class="field">
                    <label for="address_zip" class="label-required">
                      {{ 'cart.general.shipping_zip_title' | t }}
                    </label>
                    <input type="text" id="address_zip" name="address[zip]"
                           {% if shop.customer_accounts_enabled and customer %} value="{{ customer.default_address.zip }}"{% endif %}
                           placeholder="{{ 'cart.general.shipping_zip_placeholder' | t }}"/>
                  </p>

                  <p class="field">
                    <div class="get-rates">
                      {{ 'cart.general.shipping_calculator_submit_button_label' | t }}
                    </div>
                  </p>
                </div>

                <p class="shipping-calculator-info d-none mb-10"></p>
                <div id="wrapper-response"></div>
              </div>

              <script>
                theme.AssetsLoader.require('scripts', 'plugin_shipping_rates_calculation');
                theme.AssetsLoader.require('scripts', 'shipping_rates_calculation');
              </script>

              <script id="shipping-calculator-response-template" type="text/template">
                {% raw %}
                  <p id="shipping-rates-feedback" {{#if success}} class="success" {{else}} class="error" {{/if}}>
                  {{#if success}}
                  {{#if rates}}
                  {{#rates}}
                  {{#if @first}}
                  Rates start at {{price}}.
                  {{/if}}
                  {{/rates}}
                  {{else}}
                  We do not ship to this destination.
                  {{/if}}
                  {{else}}
                  {{ errorFeedback }}
                  {{/if}}
                  </p>
                {% endraw %}
              </script>
              {%- endunless -%}

            </div>
          </div>
          <!-- /SHIPPING CALCULATOR -->

        </div>

      </div>
    </div>

  </form>

  <!-- MOBILE STICKY CHECKOUT -->
  <div class="mobile-checkout-bar d-lg-none">
    <strong>{{ cart.total_price | money }}</strong>
    <button class="btn-modern"
            onclick="document.querySelector(`[name='checkout']`).click()">
      {{ 'cart.general.checkout' | t }}
    </button>
  </div>

{%- else -%}
  <div class="cart d-flex flex-column align-items-center py-40 py-md-100 my-100">
    <h1 class="h3">{{ 'cart.general.empty_title' | t }}</h1>
    <p>{{ 'cart.general.empty_paragraph' | t }}</p>
    <a href="/collections/all" class="btn-modern mt-20">{{ 'cart.general.empty_button' | t }}</a>
  </div>
{%- endif -%}

</div>